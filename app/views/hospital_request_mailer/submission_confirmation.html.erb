<table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 620px; background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; font-family: Arial, Helvetica, sans-serif; margin: 20px auto; color: #334155;">
  
  <!-- Header -->
  <tr>
    <td style="background-color: #0f766e; padding: 24px 32px; text-align: center;">
      <h1 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: bold;">HMS Healthcare</h1>
      <p style="color: #99f6e4; margin: 4px 0 0 0; font-size: 13px;">Hospital Network Empanelment Desk</p>
    </td>
  </tr>

  <!-- Body Content -->
  <tr>
    <td style="padding: 28px 32px;">
      <h2 style="font-size: 17px; color: #0f172a; margin-top: 0;">
        Hello, <%= @hospital_request.contact_person_name %>!
      </h2>
      <p style="font-size: 13px; line-height: 1.6; color: #475569;">
        We have successfully received your partnership application to list <strong><%= @hospital_request.hospital_name %></strong> on the HMS central healthcare directory.
      </p>

      <!-- Application Summary Card -->
      <table width="100%" cellpadding="9" cellspacing="0" style="background-color: #f0fdfa; border-radius: 8px; border: 1px solid #ccfbf1; margin: 20px 0; font-size: 12px;">
        <tr>
          <td style="font-weight: bold; color: #0f766e; width: 35%;">Tracking Token:</td>
          <td style="color: #0f172a; font-family: monospace; font-weight: bold;">#<%= @hospital_request.id %></td>
        </tr>
        <tr>
          <td style="font-weight: bold; color: #0f766e;">Facility Name:</td>
          <td style="color: #0f172a; font-weight: bold;"><%= @hospital_request.hospital_name %></td>
        </tr>
        <tr>
          <td style="font-weight: bold; color: #0f766e;">Location:</td>
          <td style="color: #0f172a;"><%= @hospital_request.city %>, <%= @hospital_request.state %></td>
        </tr>
        <tr>
          <td style="font-weight: bold; color: #0f766e;">Capacity:</td>
          <td style="color: #0f172a;"><%= @hospital_request.total_beds.presence || "Not specified" %> Beds</td>
        </tr>
        <tr>
          <td style="font-weight: bold; color: #0f766e;">Specialties:</td>
          <td style="color: #0f172a;"><%= @hospital_request.specialties.presence || "General Care" %></td>
        </tr>
        <tr>
          <td style="font-weight: bold; color: #0f766e;">Current Status:</td>
          <td style="color: #d97706; font-weight: bold; text-transform: uppercase;"><%= @hospital_request.status %></td>
        </tr>
      </table>

      <!-- Next Steps Callout -->
      <div style="background-color: #f8fafc; border-left: 4px solid #0f766e; padding: 12px 16px; border-radius: 4px; margin-top: 20px; font-size: 12px; color: #334155; line-height: 1.5;">
        <strong>Verification Phase:</strong> Our medical licensing and compliance team will examine your facility details within <strong>2 business days</strong>. We may reach out to <strong><%= @hospital_request.phone %></strong> to schedule an initial verification review.
      </div>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background-color: #f8fafc; padding: 14px 32px; text-align: center; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0;">
      HMS Hospital Central OPD Management System &bull; Confidential Partnership Notice
    </td>
  </tr>
</table>