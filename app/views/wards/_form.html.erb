<%= form_with(model: (ward.new_record? ? [@hospital, ward] : ward), class: "needs-validation") do |f| %>
        <% if ward.errors.any? %>
          <div class="alert alert-danger">
            <%= ward.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "Ward Name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :ward_type, "Ward Type", class: "form-label" %>
          <%= f.text_field :ward_type, class: "form-control" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit class: "btn btn-warning" %>
          <%= link_to "Cancel", hospital_path(@hospital), class: "btn btn-outline-secondary" %>
        </div>
<% end %>