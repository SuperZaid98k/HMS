<%= form_with(model:[@hospital, department], class: "needs-validation") do |f| %>
        <% if @department.errors.any? %>
          <div class="alert alert-danger">
            <%= @department.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "Department Name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit class: "btn btn-warning" %>
          <%= link_to "Cancel", hospital_path(@hospital), class: "btn btn-outline-secondary" %>
        </div>
<% end %>