<% 
  # Determines endpoint dynamically based on whether it's a new or existing record
  form_url = patient_profile.new_record? ? patient_profiles_path : patient_profile_path(patient_profile)
%>

<%= form_with(model: patient_profile, url: form_url, class: "space-y-6") do |f| %>
  
  <!-- Error Summary Block -->
  <% if patient_profile.errors.any? %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
      <div class="flex items-center gap-2 font-bold mb-1">
        <span>⚠️</span>
        <span><%= pluralize(patient_profile.errors.count, "error") %> prohibited this profile from being saved:</span>
      </div>
      <ul class="list-disc list-inside space-y-0.5 ml-4">
        <% patient_profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- SECTION 1: Personal Details -->
  <div class="space-y-4">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">1. Personal Identity</h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, "First Name *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.text_field :first_name, placeholder: "e.g. John", required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
      </div>

      <div>
        <%= f.label :last_name, "Last Name *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.text_field :last_name, placeholder: "e.g. Doe", required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
      </div>
    </div>
  </div>

  <!-- SECTION 2: Contact & Medical Metrics -->
  <div class="space-y-4 pt-2">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">2. Medical & Contact Information</h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :phone, "Primary Phone Number *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.telephone_field :phone, placeholder: "e.g. +91 98765 43210", required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
      </div>

      <div>
        <%= f.label :date_of_birth, "Date of Birth *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.date_field :date_of_birth, required: true, max: Date.current.to_s,
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :gender, "Gender *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.select :gender, [["Male", "male"], ["Female", "female"], ["Other", "other"]], 
              { prompt: "-- Select Gender --" }, 
              { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition", required: true } %>
      </div>

      <div>
        <%= f.label :blood_group, "Blood Group", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.select :blood_group, ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], 
              { prompt: "-- Select Blood Group --" }, 
              { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" } %>
      </div>
    </div>
  </div>

  <!-- SECTION 3: Residential Address -->
  <div class="space-y-4 pt-2">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">3. Residential Address</h3>
    </div>

    <div>
      <%= f.label :address, "Full Address", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
      <%= f.text_area :address, rows: 3, placeholder: "House/Flat No., Street Name, City, State, PIN code",
            class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
    <%= f.submit (patient_profile.new_record? ? "Save & Continue to Booking" : "Update Patient Profile"), 
          class: "w-full sm:w-auto px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer" %>
    
    <%= link_to "Cancel", root_path, 
          class: "w-full sm:w-auto text-center px-5 py-2.5 rounded-xl border border-gray-200 hover:bg-gray-50 text-gray-600 font-semibold text-xs transition" %>
  </div>

<% end %>