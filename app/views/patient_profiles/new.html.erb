<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Top Breadcrumb & Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-6 rounded-full bg-teal-600 inline-block"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Patient Onboarding</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Complete Your Patient Profile
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
          Please fill in your personal and clinical details before booking your appointment.
        </p>
      </div>

      <%= link_to root_path, class: "self-start sm:self-center inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-teal-700 bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-sm hover:shadow transition" do %>
        <span>← Cancel</span>
      <% end %>
    </div>

    <!-- Helpful Notification Banner -->
    <div class="flex items-center gap-3 p-4 rounded-2xl bg-teal-50 border border-teal-200/80 text-teal-900 text-xs shadow-sm">
      <div class="w-8 h-8 rounded-xl bg-teal-600 text-white flex items-center justify-center flex-shrink-0 text-sm">
        📋
      </div>
      <div>
        <strong class="font-bold">Required for Care Coordination:</strong> Your medical information allows consulting doctors to review your profile and prepare clinical charts before your visit.
      </div>
    </div>

    <!-- Main Card Container -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-200/90 p-6 sm:p-10">
      <%= render "form", patient_profile: @patient_profile %>
    </div>

  </div>
</div>