<div class="min-h-screen bg-slate-50 py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Header Hero Banner -->
    <div class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 space-y-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-teal-100 border border-white/20 uppercase tracking-wider">
          🏥 Institution Onboarding
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Partner with HMS Healthcare
        </h1>
        <p class="text-teal-100 text-sm sm:text-base max-w-2xl leading-relaxed font-normal">
          List your clinic, hospital branch, or specialty medical centre on our centralized OPD consultation and inpatient directory network.
        </p>
      </div>

      <!-- Trust Pillars -->
      <div class="mt-8 pt-6 border-t border-white/15 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-teal-100">
        <div class="flex items-center gap-2">
          <span class="text-emerald-300 font-bold text-sm">✓</span>
          <span>Centralized OPD Scheduling</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-300 font-bold text-sm">✓</span>
          <span>Direct Electronic Health Records</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-300 font-bold text-sm">✓</span>
          <span>Verified Clinical Credentialing</span>
        </div>
      </div>
    </div>

    <!-- Application Form Container -->
    <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm p-6 sm:p-10">
      <%= form_with(model: @hospital_request, class: "space-y-6", id: "hospital-request-form") do |form| %>

        <!-- Error Summary -->
        <% if @hospital_request.errors.any? %>
          <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
            <div class="flex items-center gap-2 font-bold mb-1">
              <span>⚠️</span>
              <span><%= pluralize(@hospital_request.errors.count, "error") %> prohibited this application from being submitted:</span>
            </div>
            <ul class="list-disc list-inside space-y-0.5 ml-4">
              <% @hospital_request.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- SECTION 1: Facility Information -->
        <div class="space-y-4">
          <div class="border-b border-gray-100 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">1. Hospital & Facility Overview</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <%= form.label :hospital_name, "Hospital / Medical Center Name *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.text_field :hospital_name, 
                    placeholder: "e.g. City Care Multispeciality Hospital", 
                    required: true,
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            </div>

            <div>
              <%= form.label :total_beds, "Total Bed Capacity", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.number_field :total_beds, 
                    min: 1, 
                    placeholder: "e.g. 150",
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            </div>
          </div>

          <div>
            <%= form.label :specialties, "Primary Clinical Specialties / Departments", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
            <%= form.text_field :specialties, 
                  placeholder: "e.g. Cardiology, Neurology, Orthopedics, Pediatrics, 24/7 ICU Trauma", 
                  class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            <p class="text-[11px] text-gray-400 mt-1">Comma-separated clinical disciplines offered at this facility.</p>
          </div>
        </div>

        <!-- SECTION 2: Location & Address -->
        <div class="space-y-4 pt-2">
          <div class="border-b border-gray-100 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">2. Physical Location</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :city, "City / Municipality *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.text_field :city, 
                    placeholder: "e.g. Nagpur", 
                    required: true,
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            </div>

            <div>
              <%= form.label :state, "State / Province", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.text_field :state, 
                    placeholder: "e.g. Maharashtra", 
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            </div>
          </div>

          <div>
            <%= form.label :address, "Complete Facility Street Address *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
            <%= form.text_area :address, 
                  rows: 2, 
                  placeholder: "Plot/Building No., Landmark, Medical Zone...", 
                  required: true,
                  class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
          </div>
        </div>

        <!-- SECTION 3: Official Representative / Contact Person -->
        <div class="space-y-4 pt-2">
          <div class="border-b border-gray-100 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">3. Official Representative Contact</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <%= form.label :contact_person_name, "Representative Full Name *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.text_field :contact_person_name, 
                    placeholder: "e.g. Dr. Rajesh Sharma (Medical Director)", 
                    required: true,
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            </div>

            <div>
              <%= form.label :email, "Official Email Address *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.email_field :email, 
                    placeholder: "director@hospitalcare.org", 
                    required: true,
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
            </div>

            <div>
              <%= form.label :phone, "Official Contact Phone *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= form.telephone_field :phone, 
                    placeholder: "+91 98765 43210", 
                    required: true,
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition font-mono" %>
            </div>
          </div>

          <div>
            <%= form.label :notes, "Accreditations & Additional Notes (Optional)", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
            <%= form.text_area :notes, 
                  rows: 3, 
                  placeholder: "Mention accreditations (NABH, JCI, ISO), insurance partnerships, or ambulance fleet details...", 
                  class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
          </div>
        </div>

        <!-- Form Submission Controls -->
        <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
          <%= form.submit "Submit Hospital Registration Request", 
                class: "w-full sm:w-auto px-8 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer" %>

          <%= link_to "Cancel", root_path, 
                class: "w-full sm:w-auto text-center px-5 py-2.5 rounded-xl border border-gray-200 hover:bg-gray-50 text-gray-600 font-semibold text-xs transition" %>
        </div>

      <% end %>
    </div>

  </div>
</div>