<div class="min-h-screen bg-slate-50 py-12">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Confirmation Banner -->
    <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm p-8 text-center space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 mx-auto flex items-center justify-center text-3xl shadow-sm border border-emerald-100">
        ✓
      </div>

      <div class="space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Request Token #<%= @hospital_request.id %></span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Application Received
        </h1>
        <p class="text-sm text-gray-500 max-w-md mx-auto">
          We have registered the onboarding request for <strong class="text-gray-900"><%= @hospital_request.hospital_name %></strong>.
        </p>
      </div>

      <!-- Application Details Card -->
      <div class="bg-slate-50 rounded-2xl p-5 border border-gray-200/80 text-left text-xs space-y-3">
        <div class="flex justify-between border-b border-gray-200/60 pb-2">
          <span class="text-gray-500 font-medium">Status:</span>
          <span class="px-2.5 py-0.5 rounded-full font-bold uppercase text-[10px] bg-amber-50 text-amber-700 border border-amber-200">
            ● <%= @hospital_request.status.humanize %>
          </span>
        </div>
        <div class="flex justify-between border-b border-gray-200/60 pb-2">
          <span class="text-gray-500 font-medium">Contact Person:</span>
          <span class="font-bold text-gray-900"><%= @hospital_request.contact_person_name %></span>
        </div>
        <div class="flex justify-between border-b border-gray-200/60 pb-2">
          <span class="text-gray-500 font-medium">Email Address:</span>
          <span class="font-bold text-gray-900"><%= @hospital_request.email %></span>
        </div>
        <div class="flex justify-between border-b border-gray-200/60 pb-2">
          <span class="text-gray-500 font-medium">Location:</span>
          <span class="font-bold text-gray-900"><%= @hospital_request.city %>, <%= @hospital_request.state %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500 font-medium">Recorded At:</span>
          <span class="font-bold text-gray-900"><%= @hospital_request.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
        </div>
      </div>

      <!-- What happens next notification -->
      <div class="p-4 rounded-xl bg-teal-50 border border-teal-100 text-teal-800 text-xs text-left">
        <strong>What happens next?</strong> Our hospital partnerships team reviews credentials, clinical licenses, and facilities within 2 business days before establishing your central OPD node.
      </div>

      <div class="pt-2">
        <%= link_to "← Return to Homepage", root_path, class: "inline-block px-6 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs shadow transition" %>
      </div>
    </div>

  </div>
</div>