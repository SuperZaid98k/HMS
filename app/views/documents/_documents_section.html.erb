<div class="card mb-4">
  <div class="card-header">
    Documents (<%= documentable.documents.count %>)
  </div>
  <div class="card-body">
    <% if documentable.documents.any? %>
      <table class="table table-striped table-hover align-middle mb-4">
        <thead class="table-dark">
          <tr>
            <th>Document Name</th>
            <th>File URL / Path</th>
            <th>Uploaded At</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% documentable.documents.each do |doc| %>
            <tr>
              <td><strong><%= doc.name %></strong></td>
              <td><%= link_to doc.file_url, doc.file_url, target: "_blank", rel: "noopener" %></td>
              <td><%= doc.uploaded_at %></td>
              <td class="text-end">
                <% if can? :destroy, doc %>
                  <%= button_to "Remove", document_path(doc), 
                                method: :delete, 
                                class: "btn btn-sm btn-danger",
                                data: { turbo_confirm: "Delete this document?" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">No documents attached yet.</p>
    <% end %>

    <!-- Attach Document Form -->
    <% if can? :create, Document %>
      <div class="card bg-light p-3">
        <h5 class="mb-3">Attach New Document</h5>
        <%= form_with(model: Document.new) do |f| %>
          <%= f.hidden_field :documentable_type, value: documentable.class.name %>
          <%= f.hidden_field :documentable_id, value: documentable.id %>
          <div class="row">
            <div class="col-sm-6 mb-2">
              <%= f.label :name, "Document Name", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "e.g. Lab Report Scan, X-Ray File" %>
            </div>
            <div class="col-sm-6 mb-2">
              <%= f.label :file_url, "File URL / Path", class: "form-label" %>
              <%= f.text_field :file_url, class: "form-control", placeholder: "e.g. /uploads/reports/scan1.pdf" %>
            </div>
          </div>
          <%= f.submit "Attach Document", class: "btn btn-primary btn-sm mt-2" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
