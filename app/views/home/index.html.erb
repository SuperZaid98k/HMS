  hospital_photos = [
    "https://images.unsplash.com/photo-1586773860418-d37222d8fce3?auto=format&fit=crop&w=800&q=80",
    "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=800&q=80",
    "https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=800&q=80",
    "https://images.unsplash.com/photo-1587351021759-3e566b6af7cc?auto=format&fit=crop&w=800&q=80"
  ]

  specialization_photos = [
    "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1532938911079-1b06ac7ceec7?auto=format&fit=crop&w=600&q=80"
  ]
%>

<div class="min-h-screen bg-slate-50 space-y-12 pb-20">

  <!-- ================= 0. EMERGENCY & TRUST BANNER ================= -->
  <div class="bg-teal-900 text-teal-100 text-xs py-2.5 px-4 border-b border-teal-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center gap-2 text-center sm:text-left">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500 text-white animate-pulse">24/7 ACTIVE</span>
        <span>Emergency & Critical Care Helpline: <strong>+91 (0712) 280-4500</strong></span>
      </div>
      <div class="hidden md:flex items-center gap-4 text-[11px] text-teal-200">
        <span>✓ NABH & JCI Accredited</span>
        <span>✓ 100% Cashless Mediclaim Accepted</span>
        <span>✓ Verified Medical Specialists</span>
      </div>
    </div>
  </div>

  <!-- ================= 1. HERO SECTION ================= -->
  <section class="relative bg-gradient-to-br from-teal-800 via-teal-700 to-cyan-800 text-white rounded-3xl overflow-hidden shadow-2xl mx-3 sm:mx-6 lg:mx-8">
    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -top-20 w-96 h-96 bg-cyan-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 py-10 sm:py-16 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Copy & Navigation Actions -->
      <div class="lg:col-span-7 space-y-5 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-teal-100 text-xs font-semibold uppercase tracking-wider backdrop-blur-md border border-white/20">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Integrated Healthcare Management Portal
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white">
          World-Class Care, <br>
          <span class="text-teal-200">Trusted Medical Specialists.</span>
        </h1>

        <p class="text-teal-100 text-sm sm:text-base max-w-xl font-normal leading-relaxed">
          Book immediate appointments with certified clinical doctors, discover accredited hospital wards, and manage complete health records from one portal.
        </p>

        <!-- Quick Module Navigation Badges -->
        <div class="flex flex-wrap gap-2 pt-2">
          <% if can? :read, DoctorProfile %>
            <a href="#doctors-showcase" class="px-3.5 py-2 rounded-xl bg-white text-teal-900 hover:bg-teal-50 text-xs font-bold transition shadow-md flex items-center gap-1.5">
              <span>🩺</span> Doctors (<%= @doctor_profiles.size %>)
            </a>
          <% end %>

          <% if can? :read, Hospital %>
            <a href="#hospitals-section" class="px-3.5 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-semibold backdrop-blur-md border border-white/20 transition flex items-center gap-1.5">
              <span>🏥</span> Hospitals (<%= @hospitals.size %>)
            </a>
          <% end %>

          <% if can? :read, Specialization %>
            <a href="#specializations-section" class="px-3.5 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-semibold backdrop-blur-md border border-white/20 transition flex items-center gap-1.5">
              <span>🔬</span> Specializations (<%= @specializations.size %>)
            </a>
          <% end %>

          <% if can? :manage, User %>
            <%= link_to staff_management_path, class: "px-3.5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-900 text-xs font-bold transition shadow-md" do %>
              🛡️ Users Portal
            <% end %>
          <% end %>
        </div>

        <!-- Social Proof Metrics -->
        <div class="pt-4 grid grid-cols-3 gap-4 border-t border-white/15 max-w-md">
          <div>
            <div class="text-xl sm:text-2xl font-black text-white">99.2%</div>
            <div class="text-[11px] text-teal-200 font-medium">Patient Recovery</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-white">150+</div>
            <div class="text-[11px] text-teal-200 font-medium">Specialists</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-white">24/7</div>
            <div class="text-[11px] text-teal-200 font-medium">Coverage</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Hero Graphic -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm">
          <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white/20 bg-teal-950/40">
            <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=800&q=80" 
                 alt="Chief Medical Officer" 
                 class="w-full h-72 sm:h-80 object-cover object-top hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-teal-950 via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute bottom-4 left-5 right-5 text-white">
              <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/90 text-white text-[10px] font-bold mb-1 uppercase tracking-wider">
                Direct OPD Booking
              </span>
              <h4 class="text-base font-bold">Instant Clinical Consultation</h4>
              <p class="text-xs text-teal-200">Guaranteed slots with leading surgeons & consultants</p>
            </div>
          </div>

          <div class="absolute -top-4 -left-4 bg-white text-slate-800 rounded-2xl shadow-xl p-3 border border-gray-100 flex items-center gap-3 animate-bounce" style="animation-duration: 4s;">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl font-bold">
              ★
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">4.9 / 5.0 Rating</div>
              <div class="text-[10px] text-slate-500">From 10,000+ Patients</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= 2. DOCTORS SHOWCASE (HORIZONTAL SCROLLER) ================= -->
  <section id="doctors-showcase" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    
    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-6 rounded-full bg-teal-600 inline-block"></span>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">Featured Doctors & Specialists</h2>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Swipe horizontally to browse consulting doctors</p>
      </div>

      <div class="flex items-center gap-2">
        <button id="docSlideLeftBtn" type="button" aria-label="Slide Left"
                class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-teal-600 hover:border-teal-400 flex items-center justify-center transition">
          &#8592;
        </button>
        <button id="docSlideRightBtn" type="button" aria-label="Slide Right"
                class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-teal-600 hover:border-teal-400 flex items-center justify-center transition">
          &#8594;
        </button>

        <% if can? :create, DoctorProfile %>
          <%= link_to "+ Add", new_doctor_profile_path, class: "hidden sm:inline-block px-3 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold ml-1 transition shadow-sm" %>
        <% end %>
      </div>
    </div>

    <% if @doctor_profiles.any? %>
      <div id="doctorCarouselTrack" 
           class="flex gap-4 sm:gap-6 overflow-x-auto scroll-smooth py-2 px-1 snap-x snap-mandatory no-scrollbar"
           style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <% @doctor_profiles.each do |doctor| %>
          <% 
            doc_img = doctor_photos[doctor.id % doctor_photos.length]
            rating_score = (4.7 + ((doctor.id % 4) * 0.1)).round(1)
            review_count = 45 + (doctor.id * 17)
            specs = doctor.specializations
          %>
          
          <div class="flex-none w-[270px] sm:w-[310px] snap-start bg-white rounded-2xl border border-gray-200/90 shadow-sm hover:shadow-xl hover:border-teal-500 transition-all duration-300 flex flex-col justify-between overflow-hidden group">
            
            <div class="p-4 sm:p-5">
              <div class="relative w-full h-44 rounded-xl overflow-hidden mb-3 bg-slate-100">
                <img src="<%= doc_img %>" 
                     alt="Dr. <%= doctor.name %>" 
                     class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500">
                
                <span class="absolute top-2.5 left-2.5 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-600 text-white shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-white"></span> Available
                </span>

                <% if doctor.experience_years.present? %>
                  <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white/95 text-teal-800 shadow-sm">
                    <%= doctor.experience_years %>+ yrs
                  </span>
                <% end %>

                <div class="absolute bottom-2 left-2.5 bg-slate-900/75 backdrop-blur-sm text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded-md flex items-center gap-1">
                  ★ <%= rating_score %> <span class="text-white font-normal">(<%= review_count %>)</span>
                </div>
              </div>

              <div class="flex items-center gap-1">
                <h3 class="text-sm sm:text-base font-bold text-gray-900 group-hover:text-teal-600 transition truncate">
                  Dr. <%= doctor.name.presence || doctor.user&.name || "Specialist" %>
                </h3>
                <span class="text-teal-600 text-xs font-bold" title="Verified Practitioner">✓</span>
              </div>

              <p class="text-xs font-semibold text-teal-700 mt-0.5 truncate">
                <%= doctor.department&.name || "General Medicine" %>
              </p>

              <!-- In-Memory Specialization Chips -->
              <div class="mt-2.5 flex flex-wrap gap-1">
                <% if specs.present? %>
                  <% specs.first(2).each do |spec| %>
                    <span class="px-2 py-0.5 text-[10px] rounded-md bg-teal-50 text-teal-700 font-medium border border-teal-100">
                      <%= spec.name %>
                    </span>
                  <% end %>
                  <% if specs.size > 2 %>
                    <span class="px-1.5 py-0.5 text-[10px] rounded-md bg-gray-100 text-gray-600">
                      +<%= specs.size - 2 %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="px-2 py-0.5 text-[10px] rounded-md bg-slate-100 text-slate-500 font-medium">Consultant</span>
                <% end %>
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="p-3.5 bg-slate-50 border-t border-gray-100 flex flex-col gap-2">
              <%= link_to "Book Appointment", 
                          (user_signed_in? ? new_appointment_path(doctor_profile_id: doctor.id) : new_user_session_path), 
                          class: "w-full py-2 px-3 text-center text-xs font-bold rounded-xl bg-teal-600 hover:bg-teal-700 text-white shadow-sm transition" %>

              <div class="flex justify-between items-center text-xs pt-0.5">
                <% if can? :read, doctor %>
                  <%= link_to "View Profile", doctor_profile_path(doctor), class: "text-slate-600 hover:text-teal-600 font-semibold" %>
                <% end %>

                <div class="flex gap-2">
                  <% if can? :update, doctor %>
                    <%= link_to "Edit", edit_doctor_profile_path(doctor), class: "text-amber-600 hover:underline" %>
                  <% end %>
                  <% if can? :destroy, doctor %>
                    <%= button_to "Delete", doctor_profile_path(doctor), method: :delete, class: "text-red-600 hover:underline bg-transparent border-0 p-0 text-xs cursor-pointer", data: { turbo_confirm: "Delete profile?" } %>
                  <% end %>
                </div>
              </div>
            </div>

          </div>
        <% end %>

      </div>
    <% else %>
      <div class="p-8 text-center bg-white rounded-2xl border border-dashed border-gray-300 text-gray-500 text-xs">
        No doctor profiles found.
      </div>
    <% end %>
  </section>

  <!-- ================= 3. HOSPITALS (HORIZONTAL SCROLLER & VIEW ALL) ================= -->
  <section id="hospitals-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    
    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-6 rounded-full bg-cyan-600 inline-block"></span>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">Accredited Hospitals</h2>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Multispecialty facilities, emergency wards, and ICUs</p>
      </div>

      <div class="flex items-center gap-2">
        <!-- View All Link -->
        <% if can? :read, Hospital %>
          <%= link_to hospitals_path, class: "inline-flex items-center gap-1 text-xs font-bold text-cyan-700 hover:text-cyan-800 bg-cyan-50 hover:bg-cyan-100 px-3 py-1.5 rounded-xl border border-cyan-200 transition" do %>
            <span>All (<%= @hospitals.size %>)</span>
            <span>&rarr;</span>
          <% end %>
        <% end %>

        <button id="hospSlideLeftBtn" type="button" aria-label="Slide Left"
                class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-cyan-600 hover:border-cyan-400 flex items-center justify-center transition">
          &#8592;
        </button>
        <button id="hospSlideRightBtn" type="button" aria-label="Slide Right"
                class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-cyan-600 hover:border-cyan-400 flex items-center justify-center transition">
          &#8594;
        </button>

        <% if can? :create, Hospital %>
          <%= link_to "+ New", new_hospital_path, class: "hidden sm:inline-block px-3 py-1.5 rounded-xl bg-cyan-700 hover:bg-cyan-800 text-white text-xs font-bold ml-1 transition shadow-sm" %>
        <% end %>
      </div>
    </div>

    <% if @hospitals.any? %>
      <div id="hospitalCarouselTrack" 
           class="flex gap-4 sm:gap-6 overflow-x-auto scroll-smooth py-2 px-1 snap-x snap-mandatory no-scrollbar"
           style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <% @hospitals.each do |hospital| %>
          <% hosp_img = hospital_photos[hospital.id % hospital_photos.length] %>
          
          <div class="flex-none w-[270px] sm:w-[320px] snap-start bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition overflow-hidden flex flex-col justify-between group">
            
            <div>
              <div class="relative w-full h-40 overflow-hidden bg-slate-100">
                <img src="<%= hosp_img %>" 
                     alt="<%= hospital.name %>" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/75 via-transparent to-transparent"></div>
                
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/90 text-cyan-800 shadow-sm">
                  NABH Accredited
                </span>

                <div class="absolute bottom-2.5 left-3 right-3 text-white">
                  <span class="text-[10px] font-medium text-cyan-200 block">Hospital Campus</span>
                  <h3 class="text-sm sm:text-base font-bold truncate"><%= hospital.name %></h3>
                </div>
              </div>

              <div class="p-4 space-y-2">
                <p class="text-xs text-gray-600 flex items-start gap-1.5 leading-snug">
                  <svg class="w-3.5 h-3.5 text-cyan-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <span class="truncate"><%= hospital.address.presence || "Central Medical District" %></span>
                </p>

                <p class="text-xs text-gray-600 flex items-center gap-1.5 font-medium">
                  <svg class="w-3.5 h-3.5 text-cyan-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  <span class="truncate"><%= hospital.phone.presence || "+91 (0712) 280-4500" %></span>
                </p>

                <div class="flex gap-1.5 pt-1 text-[10px] text-gray-500 font-medium">
                  <span class="px-2 py-0.5 rounded bg-slate-100">ICU</span>
                  <span class="px-2 py-0.5 rounded bg-slate-100">24/7 Pharmacy</span>
                  <span class="px-2 py-0.5 rounded bg-slate-100">Ambulance</span>
                </div>
              </div>
            </div>

            <div class="px-4 py-2.5 bg-slate-50 border-t border-gray-100 flex justify-between items-center text-xs">
              <%= link_to "View Hospital →", hospital_path(hospital), class: "text-cyan-700 hover:text-cyan-800 font-bold" %>

              <div class="flex gap-2">
                <% if can? :update, hospital %>
                  <%= link_to "Edit", edit_hospital_path(hospital), class: "text-amber-600 hover:underline" %>
                <% end %>
                <% if can? :destroy, hospital %>
                  <%= button_to "Delete", hospital_path(hospital), method: :delete, class: "text-red-600 hover:underline bg-transparent border-0 p-0 text-xs cursor-pointer", data: { turbo_confirm: "Delete hospital?" } %>
                <% end %>
              </div>
            </div>

          </div>
        <% end %>

      </div>
    <% else %>
      <div class="p-8 text-center bg-white rounded-2xl border border-dashed border-gray-300 text-gray-500 text-xs">
        No hospitals listed yet.
      </div>
    <% end %>
  </section>

  <!-- ================= 4. SPECIALIZATIONS (HORIZONTAL SHELF & VIEW ALL) ================= -->
  <section id="specializations-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    
    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-6 rounded-full bg-emerald-600 inline-block"></span>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">Specialized Disciplines</h2>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Explore medical specialties and consultation departments</p>
      </div>

      <div class="flex items-center gap-2">
        <!-- View All Link -->
        <% if can? :read, Specialization %>
          <%= link_to specializations_path, class: "inline-flex items-center gap-1 text-xs font-bold text-emerald-700 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-xl border border-emerald-200 transition" do %>
            <span>All (<%= @specializations.size %>)</span>
            <span>&rarr;</span>
          <% end %>
        <% end %>

        <button id="specSlideLeftBtn" type="button" aria-label="Slide Left"
                class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-emerald-600 hover:border-emerald-400 flex items-center justify-center transition">
          &#8592;
        </button>
        <button id="specSlideRightBtn" type="button" aria-label="Slide Right"
                class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-emerald-600 hover:border-emerald-400 flex items-center justify-center transition">
          &#8594;
        </button>

        <% if can? :create, Specialization %>
          <%= link_to "+ New", new_specialization_path, class: "hidden sm:inline-block px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold ml-1 transition shadow-sm" %>
        <% end %>
      </div>
    </div>

    <% if @specializations.any? %>
      <div id="specCarouselTrack" 
           class="flex gap-4 sm:gap-5 overflow-x-auto scroll-smooth py-2 px-1 snap-x snap-mandatory no-scrollbar"
           style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <% @specializations.each do |spec| %>
          <% spec_img = specialization_photos[spec.id % specialization_photos.length] %>
          
          <div class="flex-none w-52 sm:w-60 snap-start bg-white rounded-2xl border border-gray-200 shadow-sm hover:border-emerald-500 hover:shadow-md transition overflow-hidden flex flex-col justify-between group">
            
            <div>
              <div class="relative h-28 w-full overflow-hidden bg-emerald-50">
                <img src="<%= spec_img %>" 
                     alt="<%= spec.name %>" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90">
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                <span class="absolute bottom-2 left-3 text-white font-bold text-sm truncate max-w-[85%]">
                  <%= spec.name %>
                </span>
              </div>

              <div class="p-3.5">
                <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">
                  <%= spec.description.presence || "Comprehensive diagnostic solutions, therapy, and consultant reviews." %>
                </p>
              </div>
            </div>

            <div class="p-3.5 pt-0 flex justify-between items-center text-xs">
              <%= link_to specialization_path(spec), class: "font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1" do %>
                <span>Specialists</span>
                <span>&rarr;</span>
              <% end %>

              <div class="flex gap-2">
                <% if can? :update, spec %>
                  <%= link_to "Edit", edit_specialization_path(spec), class: "text-amber-600 hover:underline" %>
                <% end %>
                <% if can? :destroy, spec %>
                  <%= button_to "Delete", specialization_path(spec), method: :delete, class: "text-red-600 hover:underline bg-transparent border-0 p-0 text-xs cursor-pointer", data: { turbo_confirm: "Delete #{spec.name}?" } %>
                <% end %>
              </div>
            </div>

          </div>
        <% end %>

      </div>
    <% else %>
      <div class="p-8 text-center bg-white rounded-2xl border border-dashed border-gray-300 text-gray-500 text-xs">
        No specializations listed.
      </div>
    <% end %>
  </section>

</div>

<!-- ================= 5. RESILIENT CAROUSEL CONTROLLER ================= -->
<script>
  let activeIntervals = [];

  function clearAllCarouselTimers() {
    activeIntervals.forEach(clearInterval);
    activeIntervals = [];
  }

  function setupTrackScroller(trackId, leftBtnId, rightBtnId, autoSlide = false, scrollStep = 320) {
    const track = document.getElementById(trackId);
    const leftBtn = document.getElementById(leftBtnId);
    const rightBtn = document.getElementById(rightBtnId);

    if (!track) return;

    if (leftBtn) {
      leftBtn.onclick = () => track.scrollBy({ left: -scrollStep, behavior: "smooth" });
    }

    if (rightBtn) {
      rightBtn.onclick = () => track.scrollBy({ left: scrollStep, behavior: "smooth" });
    }

    if (autoSlide) {
      let isPaused = false;
      track.addEventListener("mouseenter", () => { isPaused = true; });
      track.addEventListener("mouseleave", () => { isPaused = false; });
      track.addEventListener("touchstart", () => { isPaused = true; }, { passive: true });
      track.addEventListener("touchend", () => { isPaused = false; }, { passive: true });

      const timer = setInterval(() => {
        if (isPaused) return;
        const maxScrollLeft = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= maxScrollLeft - 10) {
          track.scrollTo({ left: 0, behavior: "smooth" });
        } else {
          track.scrollBy({ left: scrollStep, behavior: "smooth" });
        }
      }, 3500);

      activeIntervals.push(timer);
    }
  }

  function initHomeCarousels() {
    clearAllCarouselTimers();

    // 1. Doctors Showcase (Auto-sliding + manual buttons)
    setupTrackScroller("doctorCarouselTrack", "docSlideLeftBtn", "docSlideRightBtn", true, 310);

    // 2. Hospitals Carousel (Manual buttons + smooth touch swipe)
    setupTrackScroller("hospitalCarouselTrack", "hospSlideLeftBtn", "hospSlideRightBtn", false, 320);

    // 3. Specializations Shelf (Manual buttons + smooth touch swipe)
    setupTrackScroller("specCarouselTrack", "specSlideLeftBtn", "specSlideRightBtn", false, 240);
  }

  document.addEventListener("turbo:load", initHomeCarousels);
  document.addEventListener("turbo:before-cache", clearAllCarouselTimers);
  document.addEventListener("DOMContentLoaded", initHomeCarousels);
</script>