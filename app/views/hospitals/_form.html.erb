<%= form_with(model: hospital, class: "needs-validation") do |form| %>
  <% if hospital.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(hospital.errors.count, "error") %> prohibited this hospital from being saved:</h5>
      <ul class="mb-0">
        <% hospital.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "e.g. City Care Hospital" %>
  </div>

  <div class="mb-3">
    <%= form.label :registration_number, "Registration Number", class: "form-label" %>
    <%= form.text_field :registration_number, class: "form-control", placeholder: "e.g. REG-102938" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :phone, class: "form-label" %>
      <%= form.telephone_field :phone, class: "form-control", placeholder: "e.g. +91 9876543210" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, class: "form-control", placeholder: "contact@hospital.com" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :address, class: "form-label" %>
    <%= form.text_area :address, rows: 3, class: "form-control", placeholder: "Street, City, State, Pincode" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", hospitals_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>