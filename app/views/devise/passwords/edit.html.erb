<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-gray-100 p-8 sm:p-10 space-y-6">

    <!-- Brand Logo & Header -->
    <div class="text-center space-y-2">
      <%= link_to root_path, class: "inline-block group" do %>
        <%= image_tag "hms_logo.png", alt: "HMS Healthcare", class: "h-12 w-auto mx-auto object-contain transition-transform group-hover:scale-105 duration-200" %>
      <% end %>

      <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-teal-50 text-teal-700 text-xl font-bold mx-auto mt-2">
        🔒
      </div>

      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Set New Password</h2>
      <p class="text-xs text-gray-500 leading-relaxed">
        Choose a secure, strong password to regain access to your medical portal.
      </p>
    </div>

    <!-- Error Messages Block -->
    <% if resource.errors.any? %>
      <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
        <div class="flex items-center gap-2 font-bold mb-1">
          <span>⚠️</span>
          <span><%= pluralize(resource.errors.count, "error") %> prohibited updating password:</span>
        </div>
        <ul class="list-disc list-inside space-y-0.5 ml-2">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Password Update Form -->
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <!-- New Password -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <%= f.label :password, "New Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700" %>
          <% if @minimum_password_length %>
            <span class="text-[11px] text-gray-400 font-medium">(min <%= @minimum_password_length %> chars)</span>
          <% end %>
        </div>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
              placeholder: "••••••••",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Confirm New Password -->
      <div>
        <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
              placeholder: "••••••••",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <%= f.submit "Update Password & Sign In", 
              class: "w-full py-3 px-4 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition duration-200 cursor-pointer transform hover:-translate-y-0.5" %>
      </div>

    <% end %>

    <!-- Navigation / Help Links -->
    <div class="pt-4 border-t border-gray-100 text-center [&_a]:text-teal-600 [&_a]:font-semibold [&_a:hover]:underline text-xs space-y-1.5 flex flex-col items-center">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>