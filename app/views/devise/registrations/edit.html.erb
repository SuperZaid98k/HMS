<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Page Header & Back Button -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">Account Settings</h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">Manage your credentials, login email, and security preferences</p>
      </div>
      <%= link_to :back, class: "inline-flex items-center gap-1 text-xs font-bold text-gray-600 hover:text-teal-600 bg-white px-3 py-2 rounded-xl border border-gray-200 shadow-sm transition" do %>
        <span>← Back</span>
      <% end %>
    </div>

    <!-- Main Settings Card -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-200/90 p-6 sm:p-10 space-y-6">
      
      <!-- Error Summary -->
      <% if resource.errors.any? %>
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
          <p class="font-bold mb-1"><%= pluralize(resource.errors.count, "error") %> prevented saving changes:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
        
        <!-- SECTION 1: Personal Info -->
        <div class="space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-teal-700 border-b border-gray-100 pb-2">
            Profile Details
          </h2>

          <div>
            <%= f.label :name, "Display Name", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
            <%= f.text_field :name, autofocus: true, autocomplete: "name", required: true,
                  class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
          </div>

          <div>
            <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
            <%= f.email_field :email, autocomplete: "email", required: true,
                  class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
            
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <p class="text-xs text-amber-600 mt-1.5 flex items-center gap-1">
                ⏳ Waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong>
              </p>
            <% end %>
          </div>
        </div>

        <!-- SECTION 2: Password Change -->
        <div class="space-y-4 pt-2">
          <div class="border-b border-gray-100 pb-2">
            <h2 class="text-xs font-bold uppercase tracking-wider text-teal-700">Change Password</h2>
            <p class="text-[11px] text-gray-400">Leave these blank if you do not wish to update your password</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <div class="flex justify-between items-center mb-1">
                <%= f.label :password, "New Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700" %>
                <% if @minimum_password_length %>
                  <span class="text-[10px] text-gray-400 font-medium">(min <%= @minimum_password_length %>)</span>
                <% end %>
              </div>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••",
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••",
                    class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
            </div>
          </div>
        </div>

        <!-- SECTION 3: Current Password Confirmation -->
        <div class="space-y-2 pt-2 bg-slate-50 p-4 rounded-2xl border border-gray-200/80">
          <div>
            <%= f.label :current_password, "Current Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-0.5" %>
            <p class="text-[11px] text-gray-500 mb-2">We require your current password to authorize any changes to your profile</p>
            <%= f.password_field :current_password, autocomplete: "current-password", required: true, placeholder: "Enter current password",
                  class: "w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-white transition outline-none" %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <%= f.submit "Save & Update Profile", 
                class: "w-full sm:w-auto py-3 px-8 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition cursor-pointer" %>
        </div>

      <% end %>
    </div>

    <!-- SECTION 4: Danger Zone -->
    <div class="bg-red-50/50 rounded-3xl border border-red-200 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-red-900">Delete Account</h3>
        <p class="text-xs text-red-700 mt-0.5">
          Permanently cancel and delete your user account. This action cannot be reversed.
        </p>
      </div>

      <div>
        <%= button_to "Cancel My Account", registration_path(resource_name), 
              method: :delete, 
              data: { turbo_confirm: "Are you sure you want to permanently delete your account?" }, 
              class: "px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold shadow-sm transition whitespace-nowrap cursor-pointer" %>
      </div>
    </div>

  </div>
</div>