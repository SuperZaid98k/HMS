<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-gray-100 p-8 sm:p-10 space-y-6">
    
    <!-- Brand Logo & Header -->
    <div class="text-center space-y-2">
      <%= link_to root_path, class: "inline-block group" do %>
        <%= image_tag "hms_logo.png", alt: "HMS Healthcare", class: "h-12 w-auto mx-auto object-contain transition-transform group-hover:scale-105 duration-200" %>
      <% end %>
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Create an Account</h2>
      <p class="text-xs text-gray-500">Register as a patient to schedule visits and consult certified doctors</p>
    </div>

    <!-- Error Messages Block -->
    <% if resource.errors.any? %>
      <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
        <p class="font-bold mb-1"><%= pluralize(resource.errors.count, "error") %> prohibited registration:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Registration Form -->
    <%= form_for(resource, as: resource_name, url: user_registration_path, html: { class: "space-y-4" }) do |f| %>

      <!-- Full Name -->
      <div>
        <%= f.label :name, "Full Name", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", required: true,
              placeholder: "e.g. John Doe",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Email Address -->
      <div>
        <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email", required: true,
              placeholder: "you@example.com",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Password -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <%= f.label :password, "Create Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700" %>
          <% if @minimum_password_length %>
            <span class="text-[11px] text-gray-400 font-medium">(min <%= @minimum_password_length %> characters)</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", required: true,
              placeholder: "••••••••",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
              placeholder: "••••••••",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <%= f.submit "Create Patient Account", 
              class: "w-full py-3 px-4 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition duration-200 cursor-pointer" %>
      </div>

    <% end %>

    <!-- Devise Navigation Links -->
    <div class="pt-4 border-t border-gray-100 text-center [&_a]:text-teal-600 [&_a]:font-semibold [&_a:hover]:underline text-xs space-y-1.5 flex flex-col items-center">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>