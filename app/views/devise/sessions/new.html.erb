<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-gray-100 p-8 sm:p-10 space-y-6">
    
    <!-- Brand Logo & Header -->
    <div class="text-center space-y-2">
      <%= link_to root_path, class: "inline-block group" do %>
        <%= image_tag "hms_logo.png", alt: "HMS Healthcare", class: "h-12 w-auto mx-auto object-contain transition-transform group-hover:scale-105 duration-200" %>
      <% end %>
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Welcome Back</h2>
      <p class="text-xs text-gray-500">Sign in to access your appointments, medical records, and portal services</p>
    </div>

    <!-- Login Form -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      
      <!-- Email Field -->
      <div>
        <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
              placeholder: "you@example.com",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Password Field -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <%= f.label :password, "Password", class: "block text-xs font-bold uppercase tracking-wider text-gray-700" %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", required: true,
              placeholder: "••••••••",
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 transition outline-none" %>
      </div>

      <!-- Remember Me Checkbox -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <%= f.check_box :remember_me, class: "rounded border-gray-300 text-teal-600 focus:ring-teal-500 h-4 w-4" %>
            <span class="text-xs font-medium text-gray-600">Keep me logged in</span>
          </label>
        </div>
      <% end %>

      <!-- Submit Button -->
      <div class="pt-2">
        <%= f.submit "Sign In to Portal", 
              class: "w-full py-3 px-4 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition duration-200 cursor-pointer" %>
      </div>

    <% end %>

    <!-- Devise Navigation Links -->
    <div class="pt-4 border-t border-gray-100 text-center [&_a]:text-teal-600 [&_a]:font-semibold [&_a:hover]:underline text-xs space-y-1.5 flex flex-col items-center">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>