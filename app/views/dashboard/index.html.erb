<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Welcome Banner -->


  <% if user_signed_in? %>
    <!-- Clinical & Care Services -->
    <% if can?(:read, Appointment) || can?(:read, MedicalRecord) || can?(:read, Prescription) || can?(:read, LabTest) %>
      <div class="mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4 flex items-center gap-2">
          Clinical & Patient Care
          <span class="flex-1 h-px bg-gray-200"></span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <% if can? :read, Appointment %>
            <%= link_to appointments_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex flex-col justify-between" do %>
              <div>
                <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold mb-3 group-hover:scale-105 transition-transform">
                  📅
                </div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Appointments</h3>
                <p class="text-xs text-gray-500 mt-1">Schedules, bookings, and patient visit logs</p>
              </div>
              <span class="text-xs font-medium text-blue-600 mt-4 inline-flex items-center group-hover:translate-x-1 transition-transform">Open module &rarr;</span>
            <% end %>
          <% end %>

          <% if can? :read, MedicalRecord %>
            <%= link_to medical_records_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex flex-col justify-between" do %>
              <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-3 group-hover:scale-105 transition-transform">
                  📋
                </div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Medical Records</h3>
                <p class="text-xs text-gray-500 mt-1">Clinical notes, vitals, and diagnoses</p>
              </div>
              <span class="text-xs font-medium text-blue-600 mt-4 inline-flex items-center group-hover:translate-x-1 transition-transform">Open module &rarr;</span>
            <% end %>
          <% end %>

          <% if can? :read, Prescription %>
            <%= link_to prescriptions_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex flex-col justify-between" do %>
              <div>
                <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center font-bold mb-3 group-hover:scale-105 transition-transform">
                  💊
                </div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Prescriptions</h3>
                <p class="text-xs text-gray-500 mt-1">Doctor orders, dosage, and medication tracks</p>
              </div>
              <span class="text-xs font-medium text-blue-600 mt-4 inline-flex items-center group-hover:translate-x-1 transition-transform">Open module &rarr;</span>
            <% end %>
          <% end %>

          <% if can? :read, LabTest %>
            <%= link_to lab_tests_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex flex-col justify-between" do %>
              <div>
                <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-3 group-hover:scale-105 transition-transform">
                  🧪
                </div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Lab Tests</h3>
                <p class="text-xs text-gray-500 mt-1">Pathology, diagnostic tests, and lab reports</p>
              </div>
              <span class="text-xs font-medium text-blue-600 mt-4 inline-flex items-center group-hover:translate-x-1 transition-transform">Open module &rarr;</span>
            <% end %>
          <% end %>

        </div>
      </div>
    <% end %>

    <!-- People & Directory -->
    <% if can?(:read, Patient) || can?(:read, DoctorProfile) || can?(:manage, User) %>
      <div class="mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4 flex items-center gap-2">
          Directory & Personnel
          <span class="flex-1 h-px bg-gray-200"></span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          
          <% if can? :read, Patient %>
            <%= link_to patients_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex items-center gap-4" do %>
              <div class="w-12 h-12 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold flex-shrink-0">
                👥
              </div>
              <div>
              <% if current_user&.patient? %>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Your Profile</h3>
                <p class="text-xs text-gray-500 mt-0.5">Demographics, profiles, and registry</p>
              <% else %>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Patients</h3>
                <p class="text-xs text-gray-500 mt-0.5">Demographics, profiles, and registry</p>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if can? :read, DoctorProfile %>
            <%= link_to doctor_profiles_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex items-center gap-4" do %>
              <div class="w-12 h-12 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center text-xl font-bold flex-shrink-0">
                🩺
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Doctors</h3>
                <p class="text-xs text-gray-500 mt-0.5">Specialists, licenses, and duty profiles</p>
              </div>
            <% end %>
          <% end %>

          <% if can? :manage, StaffProfile %>
            <%= link_to staff_profiles_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex items-center gap-4" do %>
              <div class="w-12 h-12 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold flex-shrink-0">
                👨‍💼
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">Staff Management</h3>
                <p class="text-xs text-gray-500 mt-0.5">Accounts, access levels, and role controls</p>
              </div>
            <% end %>
          <% end %>

          <% if can? :manage, User %>
            <%= link_to staff_management_path, class: "group p-5 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md transition flex items-center gap-4" do %>
              <div class="w-12 h-12 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold flex-shrink-0">
                🛡️
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition">User Management</h3>
                <p class="text-xs text-gray-500 mt-0.5">Accounts, access levels, and role controls</p>
              </div>
            <% end %>
          <% end %>

        </div>
      </div>
    <% end %>

    <!-- Operations, Billing & Setup -->
    <div class="mb-8">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4 flex items-center gap-2">
        Hospital Operations & Administration
        <span class="flex-1 h-px bg-gray-200"></span>
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">

        <% if can? :read, Hospital %>
          <%= link_to hospitals_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
            <span class="text-2xl">🏥</span>
            <span class="text-xs font-semibold text-gray-800">Hospitals</span>
          <% end %>
        <% end %>

        <% if can? :read, Admission %>
          <%= link_to admissions_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
            <span class="text-2xl">🛏️</span>
            <span class="text-xs font-semibold text-gray-800">Admissions</span>
          <% end %>
        <% end %>

        <% if can? :read, Invoice %>
          <%= link_to invoices_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
            <span class="text-2xl">💳</span>
            <span class="text-xs font-semibold text-gray-800">Invoices</span>
          <% end %>
        <% end %>

        <% if can? :read, Treatment %>
          <%= link_to treatments_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
            <span class="text-2xl">🩹</span>
            <span class="text-xs font-semibold text-gray-800">Treatments</span>
          <% end %>
        <% end %>

        <% if can? :read, Medicine %>
          <%= link_to medicines_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
            <span class="text-2xl">📦</span>
            <span class="text-xs font-semibold text-gray-800">Medicines</span>
          <% end %>
        <% end %>

        <% if can? :read, Specialization %>
          <%= link_to specializations_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
            <span class="text-2xl">🎓</span>
            <span class="text-xs font-semibold text-gray-800">Specializations</span>
          <% end %>
        <% end %>

        <% if can? :read, ContactMessage %>
        <%= link_to contact_messages_path, class: "p-4 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-blue-500 hover:shadow-md text-center transition flex flex-col items-center justify-center gap-2" do %>
          <span class="text-2xl">📬</span>
          <span class="text-xs font-semibold text-gray-800">Inquiries</span>
        <% end %>
      <% end %>

      </div>
    </div>

  <% else %>
    <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-gray-300">
      <p class="text-gray-500 text-sm mb-4">Please log in to view your portal dashboard.</p>
      <%= link_to "Sign In", new_user_session_path, class: "px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm shadow-sm transition" %>
    </div>
  <% end %>
</div>