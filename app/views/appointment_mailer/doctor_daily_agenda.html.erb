<table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 620px; background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; font-family: Arial, Helvetica, sans-serif; margin: 20px auto; color: #334155;">
  
  <tr>
    <td style="background-color: #0f766e; padding: 24px 32px; text-align: center;">
      <h1 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: bold;">HMS Healthcare</h1>
      <p style="color: #99f6e4; margin: 4px 0 0 0; font-size: 13px;">Daily Clinical Consultation Agenda</p>
    </td>
  </tr>

  <tr>
    <td style="padding: 28px 32px;">
      <h2 style="font-size: 17px; color: #0f172a; margin-top: 0;">Good morning, Dr. <%= @doctor.name %>!</h2>
      <p style="font-size: 13px; color: #475569; line-height: 1.5;">
        You have <strong><%= @appointments.size %></strong> consultation(s) scheduled for today (<%= Date.current.strftime("%A, %B %d, %Y") %>):
      </p>

      <table width="100%" cellpadding="8" cellspacing="0" style="border-collapse: collapse; margin-top: 16px; font-size: 12px; border: 1px solid #e2e8f0;">
        <thead>
          <tr style="background-color: #f8fafc; border-bottom: 2px solid #cbd5e1; text-align: left; color: #475569;">
            <th style="padding: 8px;">Time</th>
            <th style="padding: 8px;">Patient Name</th>
            <th style="padding: 8px;">Reason / Symptoms</th>
            <th style="padding: 8px;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @appointments.each do |app| %>
            <% patient_name = app.patient&.patient_profile ? "#{app.patient.patient_profile.first_name} #{app.patient.patient_profile.last_name}" : "Patient ##{app.patient_id}" %>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 8px; font-weight: bold; color: #0f766e;"><%= app.scheduled_at&.strftime("%I:%M %p") %></td>
              <td style="padding: 8px; color: #0f172a; font-weight: 600;"><%= patient_name %></td>
              <td style="padding: 8px; color: #64748b;"><%= app.reason.presence || "General Review" %></td>
              <td style="padding: 8px;"><span style="background-color: #f0fdfa; color: #0f766e; padding: 2px 6px; border-radius: 4px; font-weight: bold; text-transform: uppercase; font-size: 10px;"><%= app.status %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <p style="font-size: 11px; color: #94a3b8; margin-top: 24px;">
        Log into the HMS doctor portal to review complete electronic health charts and previous lab tests.
      </p>
    </td>
  </tr>

  <tr>
    <td style="background-color: #f8fafc; padding: 14px 32px; text-align: center; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0;">
      HMS Hospital Central OPD Management System
    </td>
  </tr>
</table>