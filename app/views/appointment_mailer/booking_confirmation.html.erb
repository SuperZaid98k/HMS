<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  </head>
  <body style="font-family: Arial, Helvetica, sans-serif; background-color: #f8fafc; margin: 0; padding: 24px; color: #334155;">
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      
      <!-- Email Header -->
      <tr>
        <td style="background-color: #0f766e; padding: 24px 32px; text-align: center;">
          <h1 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: bold; letter-spacing: 0.5px;">HMS Healthcare</h1>
          <p style="color: #99f6e4; margin: 4px 0 0 0; font-size: 13px;">Appointment Booking Confirmation</p>
        </td>
      </tr>

      <!-- Body Content -->
      <tr>
        <td style="padding: 32px;">
          <h2 style="font-size: 18px; color: #0f172a; margin-top: 0;">Hello, <%= @patient.patient_profile&.first_name || "Patient" %>!</h2>
          <p style="font-size: 14px; line-height: 1.6; color: #475569;">
            Your appointment has been successfully scheduled. Below are your consultation details:
          </p>

          <!-- Appointment Summary Table -->
          <table width="100%" cellpadding="10" cellspacing="0" style="background-color: #f0fdfa; border-radius: 8px; border: 1px solid #ccfbf1; margin: 20px 0; font-size: 14px;">
            <tr>
              <td style="font-weight: bold; color: #0f766e; width: 40%;">Appointment ID:</td>
              <td style="color: #0f172a;">#<%= @appointment.id %></td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #0f766e;">Assigned Doctor:</td>
              <td style="color: #0f172a;">Dr. <%= @doctor&.name || "Specialist Consultant" %></td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #0f766e;">Department:</td>
              <td style="color: #0f172a;"><%= @doctor&.department&.name || "Outpatient Department" %></td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #0f766e;">Scheduled Date & Time:</td>
              <td style="color: #0f172a;"><%= @appointment.scheduled_at&.strftime("%B %d, %Y at %I:%M %p") || "To be confirmed" %></td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #0f766e;">Reason for Visit:</td>
              <td style="color: #0f172a;"><%= @appointment.reason.presence || "General consultation" %></td>
            </tr>
          </table>

          <p style="font-size: 13px; color: #64748b; line-height: 1.5;">
            * Please arrive 15 minutes prior to your scheduled time with any previous prescription slips or lab reports.
          </p>

          <div style="text-align: center; margin-top: 30px;">
            <a href="<%= appointment_url(@appointment) %>" style="background-color: #0f766e; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 14px; display: inline-block;">
              View Appointment Details
            </a>
          </div>
        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td style="background-color: #f1f5f9; padding: 16px 32px; text-align: center; font-size: 12px; color: #94a3b8; border-top: 1px solid #e2e8f0;">
          HMS Healthcare &bull; 24/7 Emergency Line: +91 (0712) 280-4500<br />
          If you need to reschedule or cancel, please contact the front desk.
        </td>
      </tr>

    </table>
  </body>
</html>