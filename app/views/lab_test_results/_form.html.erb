<% 
  # Explicitly use the singular route helper generated by `resource :lab_test_result`
  form_url = lab_test_lab_test_result_path(@lab_test)
  form_method = lab_test_result.new_record? ? :post : :patch
%>

<%= form_with(model: lab_test_result, url: form_url, method: form_method, class: "space-y-6") do |form| %>
  
  <!-- Error Summary Block -->
  <% if lab_test_result.errors.any? %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
      <div class="flex items-center gap-2 font-bold mb-1">
        <span>⚠️</span>
        <span><%= pluralize(lab_test_result.errors.count, "error") %> prohibited this lab result from being saved:</span>
      </div>
      <ul class="list-disc list-inside space-y-0.5 ml-4">
        <% lab_test_result.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- SECTION 1: Finding & Qualitative Outcome -->
  <div class="space-y-4">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">1. Diagnostic Outcome</h3>
    </div>

    <div>
      <%= form.label :result, "Clinical Result Outcome *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
      <%= form.select :result, 
            [
              ["Negative / Normal (No Pathology Detected)", "negative"],
              ["Positive / Abnormal (Pathology Detected)", "positive"]
            ], 
            { prompt: "-- Select Diagnostic Outcome --" }, 
            { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition", required: true } %>
      <p class="text-[11px] text-gray-400 mt-1">Select the qualitative test outcome according to laboratory protocol.</p>
    </div>
  </div>

  <!-- SECTION 2: Reference Values & Measurement -->
  <div class="space-y-4 pt-2">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">2. Reference Metrics & Metrics Calibration</h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :reference_range, "Biological Reference Range", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= form.text_field :reference_range, 
              placeholder: "e.g. 4.5 - 11.0 or Negative",
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
        <p class="text-[11px] text-gray-400 mt-1">Normal baseline parameter range</p>
      </div>

      <div>
        <%= form.label :unit, "Unit of Measurement", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= form.text_field :unit, 
              placeholder: "e.g. mg/dL, K/uL, mmol/L",
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
        <p class="text-[11px] text-gray-400 mt-1">Standard clinical reporting unit</p>
      </div>
    </div>
  </div>

  <!-- SECTION 3: Execution Timestamp -->
  <div class="space-y-4 pt-2">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">3. Verification Timestamp</h3>
    </div>

    <div>
      <%= form.label :tested_at, "Date & Time of Laboratory Analysis *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
      <%= form.datetime_local_field :tested_at, 
            value: (lab_test_result.tested_at.respond_to?(:strftime) ? lab_test_result.tested_at.strftime("%Y-%m-%dT%H:%M") : lab_test_result.tested_at || Time.current.strftime("%Y-%m-%dT%H:%M")),
            max: Time.current.strftime("%Y-%m-%dT%H:%M"),
            class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition",
            required: true %>
      <p class="text-[11px] text-gray-400 mt-1">Timestamp when the pathologist evaluated and recorded the specimen.</p>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
    <%= form.submit (lab_test_result.new_record? ? "Confirm & Record Result" : "Update Diagnostic Findings"), 
          class: "w-full sm:w-auto px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer" %>
    
    <%= link_to "Cancel", lab_test_path(@lab_test), 
          class: "w-full sm:w-auto text-center px-5 py-2.5 rounded-xl border border-gray-200 hover:bg-gray-50 text-gray-600 font-semibold text-xs transition" %>
  </div>

<% end %>