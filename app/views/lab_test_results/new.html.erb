<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Top Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-6 rounded-full bg-teal-600 inline-block"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Pathology & Diagnostics</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Record Test Result
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
          Specimen Evaluation for <strong class="text-slate-800"><%= @lab_test.test_name %></strong>
        </p>
      </div>

      <%= link_to lab_test_path(@lab_test), class: "self-start sm:self-center inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-teal-700 bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-sm hover:shadow transition" do %>
        <span>← Back to Lab Order</span>
      <% end %>
    </div>

    <!-- Specimen & Patient Snapshot Strip -->
    <div class="p-4 rounded-2xl bg-teal-50/70 border border-teal-200/80 flex items-center justify-between text-xs text-teal-950 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-teal-600 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
          🔬
        </div>
        <div>
          <span class="block text-[10px] font-bold uppercase tracking-wider text-teal-700">Lab Order Reference</span>
          <span class="font-bold text-sm text-gray-900">Lab Test #<%= @lab_test.id %></span>
        </div>
      </div>
      <div class="text-right">
        <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Target Investigation</span>
        <span class="font-semibold text-teal-800"><%= @lab_test.test_name %></span>
      </div>
    </div>

    <!-- Main Form Container -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-200/90 p-6 sm:p-10">
      <%= render "form", lab_test_result: @lab_test_result %>
    </div>

  </div>
</div>