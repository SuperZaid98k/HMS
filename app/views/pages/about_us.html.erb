<div class="min-h-screen bg-gray-50 flex flex-col justify-between">
  
  <main>
    <!-- 1. Hero Banner (Teal Gradient with Doctor Imagery) -->
    <section class="relative overflow-hidden bg-gradient-to-r from-teal-800 via-teal-700 to-emerald-600 text-white py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Banner Text & Call to Action -->
          <div class="lg:col-span-7 space-y-4">
            <span class="inline-block py-1 px-3 rounded-full bg-white/10 text-teal-100 text-xs font-semibold uppercase tracking-wider backdrop-blur-sm border border-white/20">
              Healthcare Excellence
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
              About Us
            </h1>
            <p class="text-teal-100 text-base sm:text-lg max-w-xl font-normal leading-relaxed">
              Your gateway to premium healthcare, compassionate patient assistance, and world-class medical specialists across the globe.
            </p>
            <div class="pt-2">
              <%= link_to contact_us_path, class: "inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white text-teal-900 font-semibold text-sm hover:bg-teal-50 shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5" do %>
                <span>Get in Touch</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              <% end %>
            </div>
          </div>

          <!-- Banner Doctors Graphic -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div class="relative w-72 sm:w-80 md:w-96 rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20 bg-teal-900/40 backdrop-blur-sm">
              <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=600&q=80" 
                   alt="Medical Team" 
                   class="w-full h-72 sm:h-80 object-cover object-top hover:scale-105 transition-transform duration-500">
              <div class="absolute inset-0 bg-gradient-to-t from-teal-950/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4 text-xs text-white/90 font-medium">
                Certified Doctors & Clinical Specialists
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. Main Narrative & Organization Philosophy -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
      
      <!-- Company Overview -->
      <div class="bg-white rounded-2xl p-8 sm:p-10 shadow-sm border border-gray-200/80 space-y-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 tracking-tight flex items-center gap-3">
            <span class="w-2.5 h-7 rounded-full bg-teal-600 inline-block"></span>
            Who We Are
          </h2>
          <p class="text-sm font-semibold uppercase tracking-wider text-teal-700 mt-1 ml-5">Delivering Quality Healthcare with Compassion</p>
        </div>

        <div class="space-y-4 text-gray-600 text-sm sm:text-base leading-relaxed pl-5 border-l-2 border-teal-100">
          <p>
            Established with a vision to make quality medical care universally accessible, our Hospital Management System connects patients to top-tier doctors, specialized clinical departments, and world-class accredited facilities at transparent and affordable costs.
          </p>
          <p>
            Founded by veteran clinical specialists and healthcare leaders with over 15 years of operational expertise, our patient-first approach pairs cutting-edge medical technologies with personalized human care.
          </p>
          <p>
            Our dedicated network features multidisciplinary medical professionals, state-of-the-art diagnostic testing, and comprehensive in-patient care facilities tailored to every individual's recovery pathway.
          </p>
        </div>
      </div>

      <!-- Objectives Section -->
      <div class="bg-white rounded-2xl p-8 sm:p-10 shadow-sm border border-gray-200/80 space-y-6">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight flex items-center gap-3">
            <span class="w-2.5 h-7 rounded-full bg-teal-600 inline-block"></span>
            Our Objectives
          </h3>
          <p class="text-gray-500 text-sm mt-1">To provide end-to-end solutions for patients and simplify their care experience:</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="flex items-start gap-3 p-4 rounded-xl bg-teal-50/50 border border-teal-100/60">
            <div class="w-7 h-7 rounded-full bg-teal-600 text-white flex items-center justify-center flex-shrink-0 text-sm font-bold">✓</div>
            <p class="text-sm text-gray-700 font-medium">Direct connectivity with renowned clinical specialists and seamless appointment scheduling.</p>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-xl bg-teal-50/50 border border-teal-100/60">
            <div class="w-7 h-7 rounded-full bg-teal-600 text-white flex items-center justify-center flex-shrink-0 text-sm font-bold">✓</div>
            <p class="text-sm text-gray-700 font-medium">Upfront and transparent treatment plans with comprehensive financial estimates.</p>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-xl bg-teal-50/50 border border-teal-100/60">
            <div class="w-7 h-7 rounded-full bg-teal-600 text-white flex items-center justify-center flex-shrink-0 text-sm font-bold">✓</div>
            <p class="text-sm text-gray-700 font-medium">Modern in-patient admissions, emergency response, and post-operative ward care.</p>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-xl bg-teal-50/50 border border-teal-100/60">
            <div class="w-7 h-7 rounded-full bg-teal-600 text-white flex items-center justify-center flex-shrink-0 text-sm font-bold">✓</div>
            <p class="text-sm text-gray-700 font-medium">Continuous follow-up, digital electronic medical records, and coordinated recovery guidance.</p>
          </div>
        </div>
      </div>

      <!-- Mission & Vision Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Mission Card -->
        <div class="bg-gradient-to-br from-white to-teal-50/30 rounded-2xl p-8 shadow-sm border border-teal-100 space-y-3">
          <div class="w-12 h-12 rounded-xl bg-teal-600 text-white flex items-center justify-center text-xl shadow-md">
            🎯
          </div>
          <h3 class="text-xl font-bold text-gray-900">Our Mission</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            To connect patients with compassionate, accessible, and world-class healthcare through personalized medical coordination, verified expert consultations, and transparent treatment pipelines. Every patient matters, and every recovery journey is handled with dedicated care.
          </p>
        </div>

        <!-- Vision Card -->
        <div class="bg-gradient-to-br from-white to-teal-50/30 rounded-2xl p-8 shadow-sm border border-teal-100 space-y-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-xl shadow-md">
            👁️
          </div>
          <h3 class="text-xl font-bold text-gray-900">Our Vision</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            To be the most trusted global standard in healthcare coordination—empowering patients everywhere with modern facilities, ethical medical treatment, and fully informed clinical outcomes that transcend geographic boundaries.
          </p>
        </div>

      </div>

    </section>

    
  </main>

</div>