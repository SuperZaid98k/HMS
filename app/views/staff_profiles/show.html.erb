<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Staff Profile #<%= @staff_profile.employee_number %></h1>
    <div class="d-flex gap-2">
      <% if can? :update, @staff_profile %>
        <%= link_to "Edit Profile", edit_staff_profile_path(@staff_profile), class: "btn btn-warning" %>
      <% end %>
      <% if can? :read, StaffProfile %>
        <%= link_to "Back to Staff List", staff_profiles_path, class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </div>


  <div class="card">
    <div class="card-header">
      Staff Details
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-sm-3 fw-semibold">Employee Number:</div>
        <div class="col-sm-9 mb-3"><%= @staff_profile.employee_number %></div>

        <div class="col-sm-3 fw-semibold">User Account:</div>
        <div class="col-sm-9 mb-3"><%= @staff_profile.user ? "#{@staff_profile.user.name} (#{@staff_profile.user.email})" : "No account linked" %></div>

        <div class="col-sm-3 fw-semibold">Department:</div>
        <div class="col-sm-9 mb-3"><%= @staff_profile.department&.name || "N/A" %></div>

        <div class="col-sm-3 fw-semibold">Phone:</div>
        <div class="col-sm-9 mb-3"><%= @staff_profile.phone %></div>

        <div class="col-sm-3 fw-semibold">Joining Date:</div>
        <div class="col-sm-9 mb-3"><%= @staff_profile.joining_date || "N/A" %></div>
      </div>
    </div>
  </div>
</div>
