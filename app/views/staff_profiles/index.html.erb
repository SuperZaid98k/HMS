<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Staff Members</h1>
    <% if can? :create, StaffProfile %>
      <%= link_to "Add Staff Profile", new_staff_profile_path, class: "btn btn-primary" %>
    <% end %>
  </div>


  <% if @staff_profiles.any? %>
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Employee No.</th>
          <th>User Account</th>
          <th>Department</th>
          <th>Phone</th>
          <th>Joining Date</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @staff_profiles.each do |staff| %>
          <tr>
            <td><%= staff.id %></td>
            <td><strong><%= staff.employee_number %></strong></td>
            <td><%= staff.user ? "#{staff.user.name} (#{staff.user.email})" : "No account linked" %></td>
            <td><%= staff.department&.name || "Unassigned" %></td>
            <td><%= staff.phone %></td>
            <td><%= staff.joining_date || "-" %></td>
            <td class="text-end">
              <% if can? :read, staff %>
                <%= link_to "Details", staff_profile_path(staff), class: "btn btn-sm btn-info text-white me-1" %>
              <% end %>
              <% if can? :update, staff %>
                <%= link_to "Edit", edit_staff_profile_path(staff), class: "btn btn-sm btn-warning me-1" %>
              <% end %>
              <% if can? :destroy, staff %>
                <%= button_to "Delete", staff_profile_path(staff), 
                              method: :delete, 
                              class: "btn btn-sm btn-danger d-inline", 
                              form: { style: "display:inline-block;" },
                              data: { turbo_confirm: "Are you sure you want to delete this staff profile?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="alert alert-info">
      No staff profiles found. Click "Add Staff Profile" to create one.
    </div>
  <% end %>
</div>
