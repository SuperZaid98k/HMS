<%= form_with(model: staff_profile, class: "needs-validation") do |form| %>
  <% if staff_profile.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(staff_profile.errors.count, "error") %> prohibited this staff profile from being saved:</h5>
      <ul class="mb-0">
        <% staff_profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :employee_number, "Employee Number", class: "form-label" %>
    <%= form.text_field :employee_number, class: "form-control", placeholder: "e.g. EMP-1001" %>
  </div>

  <div class="mb-3">
    <%= form.label :user_id, "Link to User Account (Optional)", class: "form-label" %>
    <%= form.collection_select :user_id, User.all, :id, ->(u) { "#{u.name} (#{u.email}) [#{u.role}]" }, { include_blank: "-- Select User Account --" }, { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.label :department_id, "Department", class: "form-label" %>
    <%= form.collection_select :department_id, Department.all, :id, :name, { prompt: "-- Select Department --" }, { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.label :phone, "Phone Number (10 digits)", class: "form-label" %>
    <%= form.text_field :phone, class: "form-control", placeholder: "e.g. 9876543210" %>
  </div>

  <div class="mb-3">
    <%= form.label :joining_date, "Joining Date", class: "form-label" %>
    <%= form.date_field :joining_date, class: "form-control" %>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", staff_profiles_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
