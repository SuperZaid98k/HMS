<div class="min-h-screen bg-slate-50 py-10" id="users-container">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- 1. Header Hero Banner -->
    <div class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 rounded-3xl p-6 sm:p-10 text-white shadow-lg relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-teal-100 border border-white/20 uppercase tracking-wider mb-3">
            Administration & Access Control
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Staff & User Management
          </h1>
          <p class="text-teal-100 text-sm sm:text-base mt-1 max-w-xl">
            Oversee user accounts, role-based privileges, clinician credentials, and internal administrative access.
          </p>
        </div>

        <!-- Quick Navigation Badges -->
        <div class="flex flex-wrap items-center gap-2.5">
          <% if can? :read, DoctorProfile %>
            <%= link_to doctor_profiles_path, class: "px-4 py-2 rounded-xl bg-white text-teal-900 hover:bg-teal-50 text-xs font-bold transition shadow-md flex items-center gap-1.5" do %>
              <span>🩺</span> Doctors Directory
            <% end %>
          <% end %>

          <% if can? :read, StaffProfile %>
            <%= link_to staff_profiles_path, class: "px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-semibold backdrop-blur-md border border-white/20 transition flex items-center gap-1.5" do %>
              <span>👥</span> Staff Profiles
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 2. Search & Filter Bar -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-gray-200/90 shadow-sm flex flex-col sm:flex-row gap-4 justify-between items-center">
      <%= form_with url: users_path, method: :get, class: "flex items-center gap-2 w-full sm:w-auto flex-1 max-w-lg", data: { turbo_frame: "_top" } do |f| %>
        <div class="relative w-full">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
            🔍
          </span>
          <%= f.text_field :query, 
                value: params[:query], 
                placeholder: "Search users by full name or email address...", 
                class: "w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-slate-50 transition" %>
        </div>

        <%= f.submit "Search", class: "px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs shadow-sm transition cursor-pointer" %>

        <% if params[:query].present? %>
          <%= link_to "Clear", users_path, class: "px-4 py-2.5 rounded-xl border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-slate-50 transition" %>
        <% end %>
      <% end %>

      <div class="text-xs text-gray-500 font-medium self-end sm:self-center">
        Total Registered: <strong class="text-teal-700 font-mono"><%= @total_users_count %> Users</strong>
      </div>
    </div>

    <!-- 3. Users Table Card -->
    <% if @users.present? %>
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-200/80 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-4 px-6">ID & Token</th>
                <th class="py-4 px-6">User Name</th>
                <th class="py-4 px-6">Account Role</th>
                <th class="py-4 px-6">Email Address</th>
                <th class="py-4 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="users-table-body" class="divide-y divide-gray-100">
              <%= render partial: "users/user_row", collection: @users, as: :user %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 4. Infinite Scroll Sentinel -->
      <% if @has_next_page %>
        <%= render "users/scroll_sentinel", next_page: @page + 1 %>
      <% else %>
        <p class="py-6 text-center text-xs font-semibold text-gray-400">
          ✓ All <%= @total_users_count %> users loaded
        </p>
      <% end %>

    <% else %>
      <!-- Zero State -->
      <div class="p-16 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500 space-y-4">
        <span class="text-4xl block">👥</span>
        <h3 class="text-lg font-bold text-gray-800">No Users Found</h3>
        <p class="text-sm text-gray-500 max-w-sm mx-auto">
          No user accounts matched your search criteria.
        </p>
        <% if params[:query].present? %>
          <%= link_to "Clear Search Filter", users_path, class: "inline-block px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs shadow transition" %>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<!-- ================= BULLETPROOF INFINITE SCROLLER ================= -->
<script>
  (function() {
    let isFetching = false;
    let observer = null;

    function checkAndTrigger() {
      if (isFetching) return;

      const sentinel = document.getElementById("scroll-sentinel");
      if (!sentinel) {
        if (observer) observer.disconnect();
        return;
      }

      const loadBtn = document.getElementById("load-more-users-btn");
      if (!loadBtn) return;

      // Check if sentinel is within 350px of the viewport
      const rect = sentinel.getBoundingClientRect();
      const inView = rect.top <= (window.innerHeight + 350);

      if (inView) {
        isFetching = true;
        loadBtn.click();
      }
    }

    function rebindObserver() {
      isFetching = false;

      const sentinel = document.getElementById("scroll-sentinel");
      if (!sentinel) return;

      if (observer) observer.disconnect();

      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            checkAndTrigger();
          }
        });
      }, {
        rootMargin: "350px"
      });

      observer.observe(sentinel);

      // Immediately check once if the newly inserted sentinel is already visible
      checkAndTrigger();
    }

    // 1. Initial Page Load (Turbo and Full DOM)
    document.addEventListener("turbo:load", rebindObserver);
    document.addEventListener("DOMContentLoaded", rebindObserver);

    // 2. Window Scroll fallback (catches fast scrolls)
    window.addEventListener("scroll", checkAndTrigger, { passive: true });

    // 3. Official Turbo Stream Render Hook: Fires right after Turbo modifies the DOM
    document.addEventListener("turbo:before-stream-render", (event) => {
      const defaultRender = event.detail.render;
      event.detail.render = (streamElement) => {
        defaultRender(streamElement);
        // The new rows and new sentinel are now in the DOM:
        setTimeout(rebindObserver, 60);
      };
    });

    // 4. MutationObserver backup: Rebinds if any table child elements are added
    const tableContainer = document.getElementById("users-container");
    if (tableContainer) {
      const domWatcher = new MutationObserver(() => {
        const sentinel = document.getElementById("scroll-sentinel");
        if (sentinel && !isFetching) {
          rebindObserver();
        }
      });
      domWatcher.observe(tableContainer, { childList: true, subtree: true });
    }

    // 5. Reset lock if a network error occurs
    document.addEventListener("turbo:fetch-request-error", () => {
      isFetching = false;
    });
  })();
</script>