<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Prescription #<%= @prescription.id %></h1>
    <div class="d-flex gap-2">
      <% if can? :update, @prescription %>
        <%= link_to "Edit Prescription", edit_prescription_path(@prescription), class: "btn btn-warning" %>
      <% end %>
      <%= link_to "Back to Prescriptions", prescriptions_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>


  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      Prescription Summary
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-sm-3 fw-semibold">Patient:</div>
        <div class="col-sm-9 mb-3">
          <% if @prescription.patient&.patient_profile %>
            <%= link_to "#{@prescription.patient.patient_profile.first_name} #{@prescription.patient.patient_profile.last_name}", patient_path(@prescription.patient) %>
          <% else %>
            Patient #<%= @prescription.patient_id %>
          <% end %>
        </div>

        <div class="col-sm-3 fw-semibold">Prescribing Doctor:</div>
        <div class="col-sm-9 mb-3">
          <% if @prescription.doctor_profile %>
            <%= link_to "Dr. #{@prescription.doctor_profile.name}", doctor_profile_path(@prescription.doctor_profile) %>
          <% else %>
            N/A
          <% end %>
        </div>

        <div class="col-sm-3 fw-semibold">Medical Record:</div>
        <div class="col-sm-9 mb-3">
          <% if @prescription.medical_record %>
            <%= link_to "Record ##{@prescription.medical_record.id} (#{@prescription.medical_record.diagnosis})", medical_record_path(@prescription.medical_record) %>
          <% else %>
            N/A
          <% end %>
        </div>

        <div class="col-sm-3 fw-semibold">Prescribed At:</div>
        <div class="col-sm-9 mb-3"><%= @prescription.prescribed_at %></div>
      </div>
    </div>
  </div>

  <!-- Prescribed Medicines Section -->
  <div class="card mb-4">
    <div class="card-header">
      Prescribed Medicines (<%= @prescription.prescription_items.count %>)
    </div>
    <div class="card-body">
      <% if @prescription.prescription_items.any? %>
        <table class="table table-striped table-hover align-middle mb-4">
          <thead class="table-dark">
            <tr>
              <th>Medicine</th>
              <th>Dosage</th>
              <th>Frequency</th>
              <th>Duration</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @prescription.prescription_items.each do |item| %>
              <tr>
                <td><strong><%= item.medicine&.name || "Medicine ##{item.medicine_id}" %></strong></td>
                <td><%= item.dosage %></td>
                <td><%= item.frequency %></td>
                <td><%= item.duration %></td>
                <td class="text-end">
                  <% if can? :destroy, item %>
                    <%= button_to "Remove", prescription_prescription_item_path(@prescription, item), 
                                  method: :delete, 
                                  class: "btn btn-sm btn-danger",
                                  data: { turbo_confirm: "Remove medicine from prescription?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No medicines added to this prescription yet.</p>
      <% end %>

      <!-- Add Medicine Item Form -->
      <% if can? :create, PrescriptionItem %>
        <div class="card bg-light p-3">
          <h5 class="mb-3">Add Medicine</h5>
          <%= form_with(model: [@prescription, @prescription.prescription_items.build]) do |f| %>
            <div class="row">
              <div class="col-sm-3 mb-2">
                <%= f.label :medicine_id, "Select Medicine", class: "form-label" %>
                <%= f.collection_select :medicine_id, Medicine.all, :id, :name, { prompt: "-- Select Medicine --" }, { class: "form-control" } %>
              </div>
              <div class="col-sm-3 mb-2">
                <%= f.label :dosage, "Dosage", class: "form-label" %>
                <%= f.text_field :dosage, class: "form-control", placeholder: "e.g. 500mg" %>
              </div>
              <div class="col-sm-3 mb-2">
                <%= f.label :frequency, "Frequency", class: "form-label" %>
                <%= f.text_field :frequency, class: "form-control", placeholder: "e.g. Twice daily" %>
              </div>
              <div class="col-sm-3 mb-2">
                <%= f.label :duration, "Duration", class: "form-label" %>
                <%= f.text_field :duration, class: "form-control", placeholder: "e.g. 5 days" %>
              </div>
            </div>
            <div class="mt-2">
              <%= f.submit "Add Medicine Item", class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
