<%
  total_invoices_count = @invoices.size
  paid_invoices_count = @invoices.count { |i| i.status.to_s.downcase == "paid" }
  due_invoices_count  = @invoices.count { |i| i.status.to_s.downcase == "due" }
  total_billed_amount = @invoices.sum { |i| i.total_amount.to_f }
%>

<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- 1. Header Banner & Quick Metrics -->
    <div class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 rounded-3xl p-6 sm:p-10 text-white shadow-lg relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-teal-100 border border-white/20 uppercase tracking-wider mb-3">
            Financial & Accounts Portal
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Invoices & Billing
          </h1>
          <p class="text-teal-100 text-sm sm:text-base mt-1 max-w-xl">
            Track clinical consultation bills, outstanding payments, itemized medical receipts, and account settlements.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <% if can? :create, Invoice %>
            <%= link_to new_invoice_path, 
                  class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-teal-900 font-bold text-xs sm:text-sm hover:bg-teal-50 shadow-md transition transform hover:-translate-y-0.5" do %>
              <span>+ Create Invoice</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Quick Financial Summary Strip -->
      <div class="mt-8 pt-6 border-t border-white/15 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <span class="text-[11px] text-teal-200 font-medium uppercase tracking-wider">Total Invoices</span>
          <div class="text-xl sm:text-2xl font-black text-white"><%= total_invoices_count %></div>
        </div>
        <div>
          <span class="text-[11px] text-teal-200 font-medium uppercase tracking-wider">Paid / Settled</span>
          <div class="text-xl sm:text-2xl font-black text-emerald-300"><%= paid_invoices_count %></div>
        </div>
        <div>
          <span class="text-[11px] text-teal-200 font-medium uppercase tracking-wider">Pending / Due</span>
          <div class="text-xl sm:text-2xl font-black text-amber-300"><%= due_invoices_count %></div>
        </div>
        <div>
          <span class="text-[11px] text-teal-200 font-medium uppercase tracking-wider">Gross Billed</span>
          <div class="text-xl sm:text-2xl font-black text-white font-mono">$<%= "%.2f" % total_billed_amount %></div>
        </div>
      </div>
    </div>

    <!-- 2. Live Search & Filter Bar -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-gray-200/90 shadow-sm flex flex-col sm:flex-row gap-4 justify-between items-center">
      <div class="relative w-full sm:w-96">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
          🔍
        </span>
        <input type="text" 
               id="invoiceSearchInput" 
               placeholder="Search by invoice #, patient, status..." 
               class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-slate-50 transition" />
      </div>

      <div class="flex items-center gap-3 text-xs text-gray-500 font-medium self-end sm:self-center">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Paid
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> Due
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span> Cancelled
        </span>
      </div>
    </div>

    <!-- 3. Invoices Table Card -->
    <% if @invoices.present? %>
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-200/80 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-4 px-6">Invoice No.</th>
                <th class="py-4 px-6">Billed Patient</th>
                <th class="py-4 px-6">Issued Date</th>
                <th class="py-4 px-6">Total Amount</th>
                <th class="py-4 px-6">Status</th>
                <th class="py-4 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="invoicesTableBody" class="divide-y divide-gray-100">
              <% @invoices.each do |inv| %>
                <%
                  patient_profile = inv.patient&.patient_profile
                  patient_name = patient_profile ? "#{patient_profile.first_name} #{patient_profile.last_name}" : "Patient ##{inv.patient_id}"
                  search_data = "#{inv.invoice_number} #{patient_name} #{inv.patient&.patient_number} #{inv.status} #{inv.total_amount}".downcase

                  status_classes = case inv.status.to_s.downcase
                  when "paid" then "bg-emerald-50 text-emerald-700 border-emerald-200"
                  when "due" then "bg-amber-50 text-amber-700 border-amber-200"
                  when "partial" then "bg-blue-50 text-blue-700 border-blue-200"
                  when "cancelled" then "bg-rose-50 text-rose-700 border-rose-200"
                  else "bg-slate-50 text-slate-700 border-slate-200"
                  end
                %>
                <tr class="invoice-row hover:bg-teal-50/40 transition group" data-searchable="<%= search_data %>">
                  
                  <!-- Invoice Number -->
                  <td class="py-4 px-6 font-mono font-bold text-teal-800">
                    <div class="flex items-center gap-2">
                      <span class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center text-xs font-bold border border-teal-100">
                        📄
                      </span>
                      <span><%= inv.invoice_number %></span>
                    </div>
                  </td>

                  <!-- Patient Name -->
                  <td class="py-4 px-6">
                    <div class="font-semibold text-slate-900 leading-snug">
                      <% if inv.patient %>
                        <%= link_to patient_path(inv.patient), class: "hover:text-teal-700 transition" do %>
                          <%= patient_name %>
                        <% end %>
                      <% else %>
                        <%= patient_name %>
                      <% end %>
                    </div>
                    <span class="text-xs text-gray-400 font-mono"><%= inv.patient&.patient_number %></span>
                  </td>

                  <!-- Issued Date -->
                  <td class="py-4 px-6 text-xs text-gray-600">
                    <span class="font-bold text-gray-900 block">
                      <%= inv.issued_at.respond_to?(:strftime) ? inv.issued_at.strftime("%b %d, %Y") : inv.created_at.strftime("%b %d, %Y") %>
                    </span>
                    <span class="text-gray-400">
                      <%= inv.issued_at.respond_to?(:strftime) ? inv.issued_at.strftime("%I:%M %p") : inv.created_at.strftime("%I:%M %p") %>
                    </span>
                  </td>

                  <!-- Total Amount -->
                  <td class="py-4 px-6 font-mono font-bold text-slate-900">
                    $<%= "%.2f" % (inv.total_amount.presence || 0.0).to_f %>
                  </td>

                  <!-- Status Badge -->
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider border <%= status_classes %>">
                      ● <%= inv.status.presence || "Due" %>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="py-4 px-6 text-right">
                    <div class="flex items-center justify-end gap-2 text-xs">
                      <% if can? :read, inv %>
                        <%= link_to "View Bill", invoice_path(inv), 
                              class: "px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-600 text-teal-700 hover:text-white font-semibold transition border border-teal-200" %>
                      <% end %>

                      <% if can? :update, inv %>
                        <%= link_to "Edit", edit_invoice_path(inv), 
                              class: "text-amber-600 hover:text-amber-700 font-medium hover:underline px-1" %>
                      <% end %>

                      <% if can? :destroy, inv %>
                        <%= button_to "Delete", invoice_path(inv), 
                              method: :delete, 
                              class: "text-red-600 hover:text-red-700 font-medium hover:underline bg-transparent border-0 p-0 text-xs cursor-pointer", 
                              form: { class: "inline-block" },
                              data: { turbo_confirm: "Are you sure you want to permanently delete invoice #{inv.invoice_number}?" } %>
                      <% end %>
                    </div>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- No Matching Search Results State -->
      <div id="noInvoicesFound" class="hidden p-12 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500">
        <span class="text-3xl block mb-2">🔍</span>
        <p class="font-bold text-gray-800">No matching invoices found</p>
        <p class="text-xs text-gray-500">Check the invoice number, patient name, or payment status filter.</p>
      </div>

    <% else %>
      <!-- Zero State (Empty Database) -->
      <div class="p-16 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500 space-y-4">
        <span class="text-4xl block">💳</span>
        <h3 class="text-lg font-bold text-gray-800">No Invoices Issued</h3>
        <p class="text-sm text-gray-500 max-w-sm mx-auto">
          No billing records or patient invoices have been created yet.
        </p>
        <% if can? :create, Invoice %>
          <%= link_to "+ Create First Invoice", new_invoice_path, 
                class: "inline-block px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow transition" %>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<!-- ================= REAL-TIME SEARCH SCRIPT ================= -->
<script>
  function setupInvoiceSearch() {
    const input = document.getElementById("invoiceSearchInput");
    const rows = document.querySelectorAll(".invoice-row");
    const noResults = document.getElementById("noInvoicesFound");

    if (!input || rows.length === 0) return;

    input.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      rows.forEach((row) => {
        const data = row.getAttribute("data-searchable") || "";
        if (data.includes(query)) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    });
  }

  document.addEventListener("turbo:load", setupInvoiceSearch);
  document.addEventListener("DOMContentLoaded", setupInvoiceSearch);
</script>