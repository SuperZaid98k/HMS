<%
  patient_profile = @invoice.patient&.patient_profile
  patient_name = patient_profile ? "#{patient_profile.first_name} #{patient_profile.last_name}" : "Patient ##{@invoice.patient_id}"
  total_paid = @invoice.payments.where(status: "completed").sum(:amount)
  balance_due = [@invoice.total_amount.to_f - total_paid.to_f, 0].max

  status_classes = case @invoice.status.to_s.downcase
  when "paid" then "bg-emerald-50 text-emerald-700 border-emerald-200"
  when "partial" then "bg-blue-50 text-blue-700 border-blue-200"
  when "cancelled" then "bg-rose-50 text-rose-700 border-rose-200"
  else "bg-amber-50 text-amber-700 border-amber-200"
  end
%>

<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Header & Action Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-6 rounded-full bg-teal-600 inline-block"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Official Clinical Bill</span>
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight font-mono">
            <%= @invoice.invoice_number %>
          </h1>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border <%= status_classes %>">
            ● <%= @invoice.status %>
          </span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-center">
        <% if can? :update, @invoice %>
          <%= link_to edit_invoice_path(@invoice), class: "px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow-sm transition" do %>
            ✏️ Edit Invoice
          <% end %>
        <% end %>

        <%= link_to invoices_path, class: "px-4 py-2 rounded-xl bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-xs font-semibold shadow-sm transition" do %>
          ← All Invoices
        <% end %>
      </div>
    </div>

    <!-- Invoice Header Summary Card -->
    <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm p-6 sm:p-8 space-y-6">
      
      <!-- Patient and Consultation Link Strip -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-6 border-b border-gray-100">
        
        <!-- Billed Patient Details -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-gray-100 flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-teal-600 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
            👤
          </div>
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-teal-700">Billed Recipient</span>
            <%= link_to patient_path(@invoice.patient), class: "text-sm font-bold text-gray-900 hover:text-teal-700 transition" do %>
              <%= patient_name %>
            <% end %>
            <p class="text-xs text-gray-400 font-mono"><%= @invoice.patient&.patient_number %></p>
          </div>
        </div>

        <!-- Appointment Link -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-gray-100 flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-cyan-700 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
            📅
          </div>
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-cyan-700">Linked Clinical Visit</span>
            <% if @invoice.appointment %>
              <%= link_to appointment_path(@invoice.appointment), class: "text-sm font-bold text-gray-900 hover:text-cyan-700 transition" do %>
                Appointment #<%= @invoice.appointment.id %>
              <% end %>
              <p class="text-xs text-gray-400"><%= @invoice.appointment.scheduled_at.try(:strftime, "%B %d, %Y") %></p>
            <% else %>
              <p class="text-sm font-semibold text-gray-500">General OPD / Pharmacy Direct</p>
            <% end %>
          </div>
        </div>

      </div>

      <!-- Financial Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
        <div>
          <span class="text-gray-400 block mb-1 font-semibold uppercase tracking-wider text-[10px]">Issued Date</span>
          <span class="font-bold text-gray-900 text-sm">
            <%= @invoice.issued_at.try(:strftime, "%B %d, %Y") || @invoice.created_at.strftime("%B %d, %Y") %>
          </span>
        </div>

        <div>
          <span class="text-gray-400 block mb-1 font-semibold uppercase tracking-wider text-[10px]">Amount Paid</span>
          <span class="font-bold text-emerald-600 text-sm font-mono">
            $<%= "%.2f" % total_paid %>
          </span>
        </div>

        <div>
          <span class="text-gray-400 block mb-1 font-semibold uppercase tracking-wider text-[10px]">Remaining Balance Due</span>
          <span class="font-black text-rose-600 text-sm font-mono">
            $<%= "%.2f" % balance_due %>
          </span>
        </div>
      </div>

    </div>

    <!-- Line Items Table Card -->
    <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-slate-50/50">
        <div>
          <h3 class="text-base font-bold text-gray-900">Billed Services & Medications</h3>
          <p class="text-xs text-gray-500">Breakdown of consultations, laboratory diagnostics, and procedures</p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-800 border border-teal-100">
          <%= @invoice.invoice_items.size %> Item(s)
        </span>
      </div>

      <% if @invoice.invoice_items.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-100 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-3 px-6">Description</th>
                <th class="py-3 px-6 text-center">Quantity</th>
                <th class="py-3 px-6 text-right">Unit Price</th>
                <th class="py-3 px-6 text-right">Subtotal</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @invoice.invoice_items.each do |item| %>
                <% 
                  qty = (item.quantity.presence || 1).to_f 
                  amt = item.amount.to_f
                %>
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="py-3.5 px-6 font-semibold text-gray-900"><%= item.description %></td>
                  <td class="py-3.5 px-6 text-center font-mono"><%= item.quantity || 1 %></td>
                  <td class="py-3.5 px-6 text-right font-mono text-gray-600">$<%= "%.2f" % amt %></td>
                  <td class="py-3.5 px-6 text-right font-mono font-bold text-slate-900">$<%= "%.2f" % (qty * amt) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="bg-slate-50/80 border-t border-gray-200">
                <td colspan="3" class="py-4 px-6 text-right font-bold text-xs uppercase tracking-wider text-gray-600">Total Billed:</td>
                <td class="py-4 px-6 text-right font-mono font-black text-teal-700 text-base">
                  $<%= "%.2f" % @invoice.total_amount.to_f %>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-xs text-gray-400">
          No charge items recorded for this invoice.
        </div>
      <% end %>
    </div>

    <!-- Payments History Section -->
    <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-slate-50/50">
        <div>
          <h3 class="text-base font-bold text-gray-900">Payment Transactions</h3>
          <p class="text-xs text-gray-500">Settlements recorded across Cash, UPI, and Card channels</p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-100">
          <%= @invoice.payments.size %> Transaction(s)
        </span>
      </div>

      <div class="p-6 space-y-6">
        <% if @invoice.payments.any? %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-slate-50 border-b border-gray-100 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                  <th class="py-3 px-4">Receipt ID</th>
                  <th class="py-3 px-4">Amount Paid</th>
                  <th class="py-3 px-4">Channel</th>
                  <th class="py-3 px-4">Processed Date</th>
                  <th class="py-3 px-4">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @invoice.payments.each do |p| %>
                  <tr class="hover:bg-slate-50/50 transition">
                    <td class="py-3 px-4 font-mono font-bold text-teal-800">#<%= p.id %></td>
                    <td class="py-3 px-4 font-mono font-bold text-emerald-600">$<%= "%.2f" % p.amount.to_f %></td>
                    <td class="py-3 px-4 uppercase text-[10px] font-bold tracking-wider text-slate-600"><%= p.payment_method %></td>
                    <td class="py-3 px-4 text-gray-600"><%= p.paid_at.try(:strftime, "%b %d, %Y at %I:%M %p") || "-" %></td>
                    <td class="py-3 px-4">
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <%= p.status %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="p-6 text-center text-xs text-gray-400 bg-slate-50/50 rounded-2xl border border-dashed border-gray-200">
            No payments have been logged for this invoice yet.
          </div>
        <% end %>

        <!-- Record Payment Form (Staff & Admin) -->
        <% if can? :create, Payment %>
          <div class="pt-4 border-t border-gray-100">
            <h4 class="text-xs font-bold uppercase tracking-wider text-teal-700 mb-3 flex items-center gap-1.5">
              <span>💳</span> Log Payment Settlement
            </h4>
            <%= form_with(model: [@invoice, @invoice.payments.build], class: "grid grid-cols-1 sm:grid-cols-4 gap-3 items-end") do |f| %>
              <div>
                <%= f.label :amount, "Amount Paid ($) *", class: "block text-[11px] font-bold uppercase tracking-wider text-gray-600 mb-1" %>
                <%= f.number_field :amount, step: "0.01", min: "0.01", value: balance_due.positive? ? balance_due : nil, placeholder: "0.00", required: true,
                      class: "w-full px-3 py-2 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 text-xs bg-slate-50 font-mono outline-none" %>
              </div>

              <div>
                <%= f.label :payment_method, "Payment Method *", class: "block text-[11px] font-bold uppercase tracking-wider text-gray-600 mb-1" %>
                <%= f.select :payment_method, [["Cash", "cash"], ["UPI / QR", "upi"], ["Debit/Credit Card", "card"]], { prompt: "-- Method --" }, 
                      { class: "w-full px-3 py-2 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 text-xs bg-slate-50 outline-none", required: true } %>
              </div>

              <div>
                <%= f.label :paid_at, "Payment Timestamp", class: "block text-[11px] font-bold uppercase tracking-wider text-gray-600 mb-1" %>
                <%= f.datetime_local_field :paid_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"),
                      class: "w-full px-3 py-2 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 text-xs bg-slate-50 outline-none" %>
              </div>

              <div>
                <%= f.submit "Record Payment", 
                      class: "w-full py-2.5 px-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs shadow-sm transition cursor-pointer" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>