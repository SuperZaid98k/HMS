<%= form_with(model: (bed.new_record? ? [@room, bed] : bed), class: "needs-validation") do |f| %>
        <% if @bed.errors.any? %>
          <div class="alert alert-danger">
            <%= @bed.errors.full_messages.to_sentence %>
          </div>
        <% end %>
        
        <div class="mb-3">
          <%= f.label :staus, "Status", class: "form-label" %>
          <%= f.text_field :status, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :bed_number, "Bed Number", class: "form-label" %>
          <%= f.text_field :bed_number, class: "form-control" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit class: "btn btn-warning" %>
          <%= link_to "Cancel", room_path(@room), class: "btn btn-outline-secondary" %>
        </div>
<% end %>