<%= form_with(model: patient, class: "space-y-6") do |form| %>

  <!-- Error Summary Alert -->
  <% if patient.errors.any? %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
      <div class="flex items-center gap-2 font-bold mb-1">
        <span>⚠️</span>
        <span><%= pluralize(patient.errors.count, "error") %> prohibited this patient record from being saved:</span>
      </div>
      <ul class="list-disc list-inside space-y-0.5 ml-4">
        <% patient.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- SECTION 1: System Identifiers -->
  <div class="space-y-4">
    <div class="border-b border-gray-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">1. Hospital Registration Identification</h3>
    </div>

    <div>
      <%= form.label :patient_number, "Patient Identification Number (UHID / MRN) *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
      <%= form.text_field :patient_number, 
            placeholder: "e.g. PAT-10001", 
            required: true,
            class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition font-mono" %>
      <p class="text-[11px] text-gray-400 mt-1">Unique medical record identifier assigned to this patient.</p>
    </div>
  </div>

  <!-- SECTION 2: Personal & Demographics (Nested Profile) -->
  <%= form.fields_for :patient_profile do |pf| %>
    <div class="space-y-4 pt-2">
      <div class="border-b border-gray-100 pb-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-teal-700">2. Demographics & Contact Information</h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= pf.label :first_name, "First Name *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
          <%= pf.text_field :first_name, placeholder: "e.g. Rahul", required: true,
                class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
        </div>

        <div>
          <%= pf.label :last_name, "Last Name *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
          <%= pf.text_field :last_name, placeholder: "e.g. Sharma", required: true,
                class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= pf.label :date_of_birth, "Date of Birth *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
          <%= pf.date_field :date_of_birth, required: true, max: Date.current.to_s,
                class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
        </div>

        <div>
          <%= pf.label :gender, "Gender *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
          <%= pf.select :gender, [["Male", "Male"], ["Female", "Female"], ["Other", "Other"]], 
                { prompt: "-- Select Gender --" }, 
                { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition", required: true } %>
        </div>

        <div>
          <%= pf.label :blood_group, "Blood Group", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
          <%= pf.select :blood_group, ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], 
                { prompt: "-- Select --" }, 
                { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" } %>
        </div>
      </div>

      <div>
        <%= pf.label :phone, "Primary Phone Number *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= pf.telephone_field :phone, placeholder: "e.g. +91 98765 43210", required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" %>
      </div>

      <div>
        <%= pf.label :address, "Residential Address", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= pf.text_area :address, rows: 3, placeholder: "House number, Street, City, State, PIN code",
              class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
      </div>
    </div>
  <% end %>

  <!-- Form Action Buttons -->
  <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
    <%= form.submit (patient.new_record? ? "Complete Registration" : "Update Patient Details"), 
          class: "w-full sm:w-auto px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer" %>
    
    <%= link_to "Cancel", patients_path, 
          class: "w-full sm:w-auto text-center px-5 py-2.5 rounded-xl border border-gray-200 hover:bg-gray-50 text-gray-600 font-semibold text-xs transition" %>
  </div>

<% end %>