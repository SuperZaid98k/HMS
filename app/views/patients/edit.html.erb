<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Header & Breadcrumb -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-6 rounded-full bg-teal-600 inline-block"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Patient Chart Management</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Edit Patient Record
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
          Updating record for <strong class="text-slate-800"><%= @patient.patient_number %></strong>
        </p>
      </div>

      <%= link_to patient_path(@patient), class: "self-start sm:self-center inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-teal-700 bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-sm hover:shadow transition" do %>
        <span>← View Chart</span>
      <% end %>
    </div>

    <!-- Edit Form Card -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-200/90 p-6 sm:p-10">
      <%= render "form", patient: @patient %>
    </div>

  </div>
</div>