<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- 1. Header Banner -->
    <div class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 rounded-3xl p-6 sm:p-10 text-white shadow-lg relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-teal-100 border border-white/20 uppercase tracking-wider mb-3">
            Central Patient Registry
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Patients Directory
          </h1>
          <p class="text-teal-100 text-sm sm:text-base mt-1 max-w-xl">
            Access medical records, scheduled visits, admissions, and insurance profiles.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <span class="px-4 py-2 bg-white/10 border border-white/20 rounded-xl text-xs font-bold text-teal-100 backdrop-blur-sm">
            Total: <%= @patients.size %> Patients
          </span>

          <% if can? :create, Patient %>
            <%= link_to new_patient_path, 
                  class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-teal-900 font-bold text-xs sm:text-sm hover:bg-teal-50 shadow-md transition transform hover:-translate-y-0.5" do %>
              <span>+ Register Patient</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 2. Live Client-Side Search Filter -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-gray-200/90 shadow-sm flex flex-col sm:flex-row gap-4 justify-between items-center">
      <div class="relative w-full sm:w-96">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
          🔍
        </span>
        <input type="text" 
               id="patientSearchInput" 
               placeholder="Search by name, ID number, or phone..." 
               class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-slate-50 transition" />
      </div>

      <div class="flex items-center gap-2 text-xs text-gray-500 font-medium self-end sm:self-center">
        <span>✓ Unified Records</span>
        <span>•</span>
        <span>✓ Insurance Linked</span>
        <span>•</span>
        <span>✓ Active OPD</span>
      </div>
    </div>

    <!-- 3. Patients Table Card -->
    <% if @patients.present? %>
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-200/80 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-4 px-6">Patient Identifier</th>
                <th class="py-4 px-6">Full Name</th>
                <th class="py-4 px-6">Contact Phone</th>
                <th class="py-4 px-6">Blood Group</th>
                <th class="py-4 px-6">Gender</th>
                <th class="py-4 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="patientsTableBody" class="divide-y divide-gray-100">
              <% @patients.each do |patient| %>
                <% 
                  profile = patient.patient_profile 
                  full_name = profile ? "#{profile.first_name} #{profile.last_name}" : "Profile Incomplete"
                  search_data = "#{patient.patient_number} #{full_name} #{profile&.phone} #{profile&.blood_group}".downcase
                %>
                <tr class="patient-row hover:bg-teal-50/40 transition group" data-searchable="<%= search_data %>">
                  
                  <!-- Patient ID -->
                  <td class="py-4 px-6 font-mono font-bold text-teal-800">
                    <div class="flex items-center gap-2">
                      <span class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center text-xs font-bold border border-teal-100">
                        #
                      </span>
                      <span><%= patient.patient_number.presence || "PAT-#{patient.id}" %></span>
                    </div>
                  </td>

                  <!-- Patient Name -->
                  <td class="py-4 px-6 font-semibold text-slate-900">
                    <%= full_name %>
                  </td>

                  <!-- Phone -->
                  <td class="py-4 px-6 text-slate-600 font-mono text-xs">
                    <%= profile&.phone.presence || "-" %>
                  </td>

                  <!-- Blood Group -->
                  <td class="py-4 px-6">
                    <% if profile&.blood_group.present? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        <%= profile.blood_group %>
                      </span>
                    <% else %>
                      <span class="text-gray-400 text-xs">-</span>
                    <% end %>
                  </td>

                  <!-- Gender -->
                  <td class="py-4 px-6 text-slate-600 capitalize text-xs">
                    <%= profile&.gender.presence || "-" %>
                  </td>

                  <!-- Action Buttons -->
                  <td class="py-4 px-6 text-right">
                    <div class="flex items-center justify-end gap-2 text-xs">
                      <% if can? :read, patient %>
                        <%= link_to "View Chart", patient_path(patient), 
                              class: "px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-600 text-teal-700 hover:text-white font-semibold transition border border-teal-200" %>
                      <% end %>

                      <% if can? :update, patient %>
                        <%= link_to "Edit", edit_patient_path(patient), 
                              class: "text-amber-600 hover:text-amber-700 font-medium hover:underline px-1" %>
                      <% end %>

                      <% if can? :destroy, patient %>
                        <%= button_to "Delete", patient_path(patient), 
                              method: :delete, 
                              class: "text-red-600 hover:text-red-700 font-medium hover:underline bg-transparent border-0 p-0 text-xs cursor-pointer", 
                              data: { turbo_confirm: "Are you sure you want to permanently remove patient #{patient.patient_number}?" } %>
                      <% end %>
                    </div>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- No Results Filter State -->
      <div id="noResultsFound" class="hidden p-12 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500">
        <span class="text-3xl block mb-2">🔍</span>
        <p class="font-bold text-gray-800">No matching patients found</p>
        <p class="text-xs text-gray-500">Check the spelling or try searching by phone number or ID.</p>
      </div>

    <% else %>
      <!-- Empty State -->
      <div class="p-16 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500 space-y-4">
        <span class="text-4xl block">👤</span>
        <h3 class="text-lg font-bold text-gray-800">No Registered Patients Yet</h3>
        <p class="text-sm text-gray-500 max-w-sm mx-auto">
          Start building your hospital registry by registering a patient below.
        </p>
        <% if can? :create, Patient %>
          <%= link_to "+ Register First Patient", new_patient_path, class: "inline-block px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow transition" %>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<script>
  function setupPatientFilter() {
    const input = document.getElementById("patientSearchInput");
    const rows = document.querySelectorAll(".patient-row");
    const noResults = document.getElementById("noResultsFound");

    if (!input || rows.length === 0) return;

    input.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      rows.forEach((row) => {
        const data = row.getAttribute("data-searchable") || "";
        if (data.includes(query)) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    });
  }

  document.addEventListener("turbo:load", setupPatientFilter);
  document.addEventListener("DOMContentLoaded", setupPatientFilter);
</script>