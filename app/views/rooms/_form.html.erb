<%= form_with(model: (room.new_record? ? [@ward, room] : room), class: "needs-validation") do |f| %>
        <% if @room.errors.any? %>
          <div class="alert alert-danger">
            <%= @room.errors.full_messages.to_sentence %>
          </div>
        <% end %>
        
        <div class="mb-3">
          <%= f.label :room_type, "Room Type", class: "form-label" %>
          <%= f.text_field :room_type, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :room_number, "Room Number", class: "form-label" %>
          <%= f.text_field :room_number, class: "form-control" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit class: "btn btn-warning" %>
          <%= link_to "Cancel", ward_path(@ward), class: "btn btn-outline-secondary" %>
        </div>
<% end %>