<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Dr. <%= @doctor_profile.name || @doctor_profile.user&.name || "Doctor Details" %></h1>
    <div class="d-flex gap-2">
      <% if can? :update, @doctor_profile %>
        <%= link_to "Edit Profile", edit_doctor_profile_path(@doctor_profile), class: "btn btn-warning" %>
      <% end %>
      <% if can? :read, DoctorProfile %>
        <%= link_to "Back to Doctors", doctor_profiles_path, class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </div>


  <div class="card mb-4">
    <div class="card-header">
      Doctor Profile Summary
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-sm-3 fw-semibold">License Number:</div>
        <div class="col-sm-9 mb-3"><%= @doctor_profile.license_number %></div>

        <div class="col-sm-3 fw-semibold">Department:</div>
        <div class="col-sm-9 mb-3"><%= @doctor_profile.department&.name || "N/A" %></div>

        <div class="col-sm-3 fw-semibold">Experience:</div>
        <div class="col-sm-9 mb-3"><%= @doctor_profile.experience_years.present? ? "#{@doctor_profile.experience_years} years" : "Not specified" %></div>

        <div class="col-sm-3 fw-semibold">User Email:</div>
        <div class="col-sm-9 mb-3"><%= @doctor_profile.user&.email || "No account linked" %></div>

        <div class="col-sm-3 fw-semibold">Mentor Doctor:</div>
        <div class="col-sm-9 mb-3"><%= @doctor_profile.mentor ? "Dr. #{@doctor_profile.mentor.name}" : "None" %></div>

        <div class="col-sm-3 fw-semibold">Specializations:</div>
        <div class="col-sm-9 mb-3">
          <% if @doctor_profile.specializations.any? %>
            <% @doctor_profile.specializations.each do |spec| %>
              <span class="badge bg-primary me-1"><%= spec.name %></span>
            <% end %>
          <% else %>
            <span class="text-muted">None assigned</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      Appointments (<%= @doctor_profile.appointments.count %>)
    </div>
    <div class="card-body">
      <% if @doctor_profile.appointments.any? %>
        <table class="table table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Patient</th>
              <th>Scheduled At</th>
              <th>Status</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody>
            <% @doctor_profile.appointments.each do |app| %>
              <tr>
                <td><%= app.id %></td>
                <td><%= app.patient&.patient_profile ? "#{app.patient.patient_profile.first_name} #{app.patient.patient_profile.last_name}" : "Patient ##{app.patient_id}" %></td>
                <td><%= app.scheduled_at.try(:strftime, "%b %d, %Y %I:%M %p") || "-" %></td>
                <td><span class="badge bg-info text-white"><%= app.status %></span></td>
                <td><%= app.reason %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted mb-0">No appointments scheduled for this doctor.</p>
      <% end %>
    </div>
  </div>
</div>
