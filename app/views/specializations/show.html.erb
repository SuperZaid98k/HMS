    "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1622902046580-2b47f47f5471?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1582750433449-648ed127bb54?auto=format&fit=crop&w=600&q=80",
    "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80",
    "https://i.pravatar.cc/300?img=24",
    "https://i.pravatar.cc/300?img=5",
    "https://i.pravatar.cc/300?img=36",
    "https://i.pravatar.cc/300?img=13",
    "https://i.pravatar.cc/300?img=41",
    "https://i.pravatar.cc/300?img=18",
    "https://i.pravatar.cc/300?img=9",
    "https://i.pravatar.cc/300?img=29",
    "https://i.pravatar.cc/300?img=1",
    "https://i.pravatar.cc/300?img=34",
    "https://i.pravatar.cc/300?img=15",
    "https://i.pravatar.cc/300?img=22",
    "https://i.pravatar.cc/300?img=3",
    "https://i.pravatar.cc/300?img=38",
    "https://i.pravatar.cc/300?img=27",
    "https://i.pravatar.cc/300?img=10",
    "https://i.pravatar.cc/300?img=31",
    "https://i.pravatar.cc/300?img=17",
    "https://i.pravatar.cc/300?img=26",
    "https://i.pravatar.cc/300?img=8",
    "https://i.pravatar.cc/300?img=40",
    "https://i.pravatar.cc/300?img=19",
    "https://i.pravatar.cc/300?img=12",
    "https://i.pravatar.cc/300?img=33",
    "https://i.pravatar.cc/300?img=20",
    "https://i.pravatar.cc/300?img=23",
    "https://i.pravatar.cc/300?img=6",
    "https://i.pravatar.cc/300?img=28",
    "https://i.pravatar.cc/300?img=11",
    "https://i.pravatar.cc/300?img=30",
    "https://i.pravatar.cc/300?img=25",
    "https://i.pravatar.cc/300?img=16",
    "https://i.pravatar.cc/300?img=14",
    "https://i.pravatar.cc/300?img=35",
    "https://i.pravatar.cc/300?img=32",
    "https://i.pravatar.cc/300?img=21"
  ]

  # Fallback to association if @doctor_profiles is not set
  doctors = @doctor_profiles || @specialization.doctor_profiles
%>

<div class="min-h-screen bg-slate-50 space-y-10 pb-20">

  <!-- ================= 1. SPECIALIZATION OVERVIEW HERO ================= -->
  <section class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 text-white pt-10 pb-14 px-4 sm:px-6 lg:px-8 shadow-md">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- Top Navigation & Action Controls -->
      <div class="flex flex-wrap justify-between items-center gap-3">
        <% if can? :read, Specialization %>
          <%= link_to specializations_path, class: "inline-flex items-center gap-1.5 text-xs font-semibold text-teal-100 hover:text-white transition" do %>
            <span>← Back to All Specializations</span>
          <% end %>
        <% end %>

        <div class="flex items-center gap-2">
          <% if can? :update, @specialization %>
            <%= link_to "Edit Details", edit_specialization_path(@specialization), class: "px-3 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-900 text-xs font-bold transition shadow-sm" %>
          <% end %>
          <% if can? :destroy, @specialization %>
            <%= button_to "Delete Specialization", specialization_path(@specialization),
                          method: :delete,
                          class: "px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-bold transition shadow-sm cursor-pointer",
                          data: { turbo_confirm: "Are you sure you want to permanently delete #{@specialization.name}?" } %>
          <% end %>
        </div>
      </div>

      <!-- Main Overview Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-white/20 text-white backdrop-blur-sm border border-white/30">
              Department Specialty #<%= @specialization.id %>
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500 text-white">
              Clinical Discipline
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            <%= @specialization.name %>
          </h1>

          <p class="text-teal-100 text-sm sm:text-base max-w-3xl leading-relaxed">
            <%= @specialization.description.presence || "Specialized therapeutic treatments, clinical diagnostic solutions, and dedicated surgical follow-up programs." %>
          </p>
        </div>

        <!-- Metric Capsule -->
        <div class="lg:col-span-4 bg-teal-900/60 backdrop-blur-md rounded-2xl p-6 border border-teal-600/50 space-y-3 text-xs">
          <div class="flex items-center justify-between">
            <span class="text-teal-200 font-medium">Available Doctors:</span>
            <span class="text-white font-extrabold text-base"><%= doctors.size %> Consultants</span>
          </div>
          <div class="flex items-center justify-between border-t border-teal-700/60 pt-3">
            <span class="text-teal-200 font-medium">Consultation Type:</span>
            <span class="text-emerald-300 font-bold">OPD & Tele-Consultation</span>
          </div>
          <div class="flex items-center justify-between border-t border-teal-700/60 pt-3">
            <span class="text-teal-200 font-medium">Scheduling:</span>
            <span class="text-white font-semibold">Immediate Slots Open</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= 2. DOCTORS CARD GRID ================= -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <div class="flex justify-between items-end border-b border-gray-200 pb-3">
      <div>
        <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
          <span class="w-2 h-5 rounded-full bg-teal-600 inline-block"></span>
          Consulting Specialists in <%= @specialization.name %> (<%= doctors.size %>)
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Select a doctor to book an instant clinical consultation</p>
      </div>

      <% if can? :create, DoctorProfile %>
        <%= link_to new_doctor_profile_path, class: "btn btn-sm btn-primary" do %>
          + Add Doctor Profile
        <% end %>
      <% end %>
    </div>

    <% if doctors.present? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% doctors.each do |doctor| %>
          <% 
            doc_img = doctor_photos[doctor.id % doctor_photos.length]
            rating_score = (4.7 + ((doctor.id % 4) * 0.1)).round(1)
            review_count = 45 + (doctor.id * 17)
            specs = doctor.specializations
          %>

          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-xl hover:border-teal-500 transition-all duration-300 flex flex-col justify-between overflow-hidden group">
            
            <div class="p-5">
              <!-- Doctor Image Container -->
              <div class="relative w-full h-44 rounded-xl overflow-hidden mb-4 bg-slate-100">
                <img src="<%= doc_img %>" 
                     alt="Dr. <%= doctor.name %>" 
                     class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500">

                <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-600 text-white shadow-sm">
                  Available
                </span>

                <% if doctor.experience_years.present? %>
                  <span class="absolute top-2.5 right-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-white/95 text-teal-800 shadow-sm">
                    <%= doctor.experience_years %>+ yrs
                  </span>
                <% end %>

                <div class="absolute bottom-2 left-2.5 bg-slate-900/75 backdrop-blur-sm text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded-md flex items-center gap-1">
                  ★ <%= rating_score %> <span class="text-white font-normal">(<%= review_count %>)</span>
                </div>
              </div>

              <!-- Doctor Credentials -->
              <div class="flex items-center gap-1">
                <h4 class="text-base font-bold text-gray-900 group-hover:text-teal-600 transition truncate">
                  Dr. <%= doctor.name.presence || doctor.user&.name || "Specialist Doctor" %>
                </h4>
                <span class="text-teal-600 text-xs font-bold" title="Verified Specialist">✓</span>
              </div>

              <p class="text-xs font-semibold text-teal-700 mt-0.5">
                <%= doctor.department&.name || "General Medicine" %>
              </p>

              <!-- In-Memory Specialization Chips (0 extra queries) -->
              <div class="mt-3 flex flex-wrap gap-1">
                <% if specs.present? %>
                  <% specs.first(2).each do |spec| %>
                    <span class="px-2 py-0.5 text-[10px] rounded-md <%= spec.id == @specialization.id ? 'bg-teal-600 text-white' : 'bg-teal-50 text-teal-700 border border-teal-100' %> font-medium">
                      <%= spec.name %>
                    </span>
                  <% end %>
                  <% if specs.size > 2 %>
                    <span class="px-1.5 py-0.5 text-[10px] rounded-md bg-gray-100 text-gray-600">
                      +<%= specs.size - 2 %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="px-2 py-0.5 text-[10px] rounded-md bg-slate-100 text-slate-500">Consultant</span>
                <% end %>
              </div>
            </div>

            <!-- Booking & Action Controls Footer -->
            <div class="p-4 bg-slate-50 border-t border-gray-100 flex flex-col gap-2">
              
              <!-- Direct Pre-Selected Doctor Booking CTA -->
              <% if can? :create, Appointment %>
                <%= link_to "Book Appointment", 
                            new_appointment_path(doctor_profile_id: doctor.id), 
                            class: "w-full py-2 px-3 text-center text-xs font-bold rounded-xl bg-teal-600 hover:bg-teal-700 text-white shadow-sm transition" %>
              <% end %>

              <div class="flex justify-between items-center text-xs pt-1">
                <% if can? :read, doctor %>
                  <%= link_to "View Profile", doctor_profile_path(doctor), class: "text-slate-600 hover:text-teal-600 font-semibold" %>
                <% end %>

                <div class="flex gap-2">
                  <% if can? :update, doctor %>
                    <%= link_to "Edit", edit_doctor_profile_path(doctor), class: "text-amber-600 hover:underline font-medium" %>
                  <% end %>
                  <% if can? :destroy, doctor %>
                    <%= button_to "Delete", doctor_profile_path(doctor), 
                                  method: :delete, 
                                  class: "text-red-600 hover:underline bg-transparent border-0 p-0 text-xs font-medium cursor-pointer",
                                  data: { turbo_confirm: "Are you sure you want to delete this doctor profile?" } %>
                  <% end %>
                </div>
              </div>

            </div>

          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-dashed border-gray-300 p-10 text-center text-gray-500">
        <p class="text-sm font-semibold text-gray-700 mb-1">No doctors currently assigned to <%= @specialization.name %>.</p>
        <p class="text-xs text-gray-400">Click "+ Add Doctor Profile" above to assign a medical specialist.</p>
      </div>
    <% end %>

  </div>

</div>    