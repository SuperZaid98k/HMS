<% 
  # Determine role-based profile destination URL
  if user_signed_in?
    patient_prof = current_user.respond_to?(:patient_profile) ? current_user.patient_profile : current_user.patient&.patient_profile
    doctor_prof  = current_user.respond_to?(:doctor_profile) ? current_user.doctor_profile : nil
    staff_prof   = current_user.respond_to?(:staff_profile) ? current_user.staff_profile : nil

    profile_target_path = case
    when current_user.admin?
      dashboard_path
    when current_user.doctor?
      doctor_prof&.persisted? ? edit_doctor_profile_path(doctor_prof) : (defined?(new_doctor_profile_path) ? new_doctor_profile_path : dashboard_path)
    when current_user.respond_to?(:staff?) && current_user.staff?
      staff_prof&.persisted? ? edit_staff_profile_path(staff_prof) : (defined?(staff_management_path) ? staff_management_path : dashboard_path)
    when current_user.patient?
      if patient_prof&.persisted?
        edit_patient_profile_path(patient_prof)
      elsif defined?(new_patient_profile_path)
        new_patient_profile_path
      else
        dashboard_path
      end
    else
      dashboard_path
    end

    user_initials = (current_user.name.presence || current_user.email).first(2).upcase
  end

  all_specializations = @specializations || Rails.cache.fetch("navbar_specializations", expires_in: 1.hour) { Specialization.order(:name).to_a }
%>

<!-- Fixed Header with Smooth Slide Animation -->
<header id="site-header" class="fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-200/80 shadow-sm transition-transform duration-300 ease-in-out">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20 items-center">
      
      <!-- 1. Brand Logo -->
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2 group transition" do %>
          <%= image_tag "hms_logo.png", 
                alt: "HMS Healthcare", 
                class: "h-11 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-200" %>
        <% end %>
      </div>

      <!-- 2. Desktop Navigation Links (hidden on mobile) -->
      <nav class="hidden md:flex items-center space-x-6 text-sm font-semibold text-gray-700">
        
        <!-- Public: Home -->
        <%= link_to "Home", root_path, class: "hover:text-teal-600 transition" %>

        <!-- Public / Patient: Doctors Dropdown -->
        <% if can? :read, Specialization %>
          <div class="relative group py-2">
            <button type="button" class="inline-flex items-center gap-1 hover:text-teal-600 transition focus:outline-none">
              <span>Find Doctors</span>
              <svg class="w-4 h-4 text-gray-400 group-hover:text-teal-600 transition-transform duration-200 group-hover:rotate-180" 
                   fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div class="absolute left-0 top-full hidden group-hover:block w-64 bg-white rounded-2xl shadow-xl border border-gray-100 py-3 z-50 animate-fadeIn">
              <%= link_to "All Specializations", specializations_path, class: "block px-4 py-2 text-xs font-bold uppercase tracking-wider text-teal-600 hover:bg-teal-50 border-b border-gray-100" %>
              
              <div class="max-h-64 overflow-y-auto divide-y divide-gray-50 py-1">
                <% all_specializations.each do |spec| %>
                  <%= link_to specialization_path(spec), class: "flex items-center justify-between px-4 py-2.5 text-sm text-gray-700 hover:bg-teal-50/80 hover:text-teal-700 transition" do %>
                    <span class="truncate"><%= spec.name %></span>
                    <span class="text-xs text-gray-400">→</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Public / Patient: Hospitals -->
        <% if can? :read, Hospital %>
          <%= link_to "Hospitals", hospitals_path, class: "hover:text-teal-600 transition" %>
        <% end %>

        <!-- Public: About & Contact -->
        <%= link_to "About Us", about_us_path, class: "hover:text-teal-600 transition" %>
        <%= link_to "Contact Us", contact_us_path, class: "hover:text-teal-600 transition" %>

        <!-- Role-Specific Links -->
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "hover:text-teal-600 transition" %>

          <% if current_user.patient? && can?(:read, Appointment) %>
            <%= link_to "My Appointments", appointments_path, class: "hover:text-teal-600 transition" %>
          <% end %>

          <% if current_user.doctor? && can?(:read, Appointment) %>
            <%= link_to "Schedule", appointments_path, class: "hover:text-teal-600 transition" %>
          <% end %>

          <% if current_user.admin? || current_user.staff? %>
            <% if can? :manage, User %>
              <%= link_to "Users", staff_management_path, class: "hover:text-teal-600 transition" %>
            <% end %>
            <% if can? :read, ContactMessage %>
              <%= link_to "Inquiries", contact_messages_path, class: "hover:text-teal-600 transition" %>
            <% end %>
          <% end %>
        <% end %>
      </nav>

      <!-- 3. Right-Side: Profile Avatar & Mobile Hamburger Toggle -->
      <div class="flex items-center gap-2 sm:gap-3">
        <% if user_signed_in? %>
          
          <!-- Profile Avatar Dropdown Trigger -->
          <div class="relative">
            <button type="button" 
                    id="profile-dropdown-btn" 
                    aria-expanded="false" 
                    aria-haspopup="true"
                    class="relative flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-gradient-to-tr from-teal-700 to-cyan-600 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg ring-2 ring-transparent hover:ring-teal-500/50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal-500 cursor-pointer">
              
              <span><%= user_initials %></span>
              <span class="absolute bottom-0 right-0 w-2.5 h-2.5 sm:w-3 sm:h-3 bg-emerald-500 border-2 border-white rounded-full"></span>
            </button>

            <!-- Dropdown Menu Window -->
            <div id="profile-dropdown-menu" 
                 class="hidden absolute right-0 mt-3 w-64 bg-white rounded-2xl shadow-xl border border-gray-100 py-2 z-50 transition-all transform opacity-0 scale-95 duration-150 ease-out origin-top-right">
              
              <div class="px-4 py-3 border-b border-gray-100 bg-slate-50/50 rounded-t-2xl">
                <p class="text-xs text-gray-500 font-medium">Signed in as</p>
                <p class="text-sm font-bold text-gray-900 truncate">
                  <%= current_user.name.presence || current_user.email %>
                </p>
                <div class="mt-1">
                  <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200">
                    <%= current_user.role %>
                  </span>
                </div>
              </div>

              <div class="py-1">
                <%= link_to dashboard_path, class: "flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-gray-700 hover:bg-teal-50/80 hover:text-teal-700 transition" do %>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span>Dashboard</span>
                <% end %>

                <%= link_to profile_target_path, class: "flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-gray-700 hover:bg-teal-50/80 hover:text-teal-700 transition" do %>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <span>
                    <% if current_user.admin? %>
                      Admin Settings
                    <% elsif current_user.patient? && patient_prof.blank? %>
                      Complete Profile ⚡
                    <% else %>
                      My Profile
                    <% end %>
                  </span>
                <% end %>
              </div>

              <div class="border-t border-gray-100 pt-1">
                <%= button_to destroy_user_session_path, method: :delete, 
                      class: "w-full flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-red-600 hover:bg-red-50 transition cursor-pointer text-left" do %>
                  <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span>Log out</span>
                <% end %>
              </div>

            </div>
          </div>

        <% else %>
          <!-- Guest CTAs (Desktop) -->
          <div class="hidden sm:flex items-center gap-2">
            <%= link_to "Log in", new_user_session_path, 
                  class: "px-3.5 py-2 text-xs font-bold text-gray-700 hover:text-teal-600 transition" %>

            <%= link_to "Book Appointment", new_user_session_path, 
                  class: "px-4 py-2 text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 rounded-xl shadow-md hover:shadow transition transform hover:-translate-y-0.5" %>
          </div>
        <% end %>

        <!-- 4. Mobile Hamburger Button (visible on mobile only) -->
        <button type="button" 
                id="mobile-menu-btn" 
                aria-expanded="false" 
                aria-controls="mobile-menu"
                class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl text-gray-700 hover:text-teal-700 hover:bg-teal-50 border border-gray-200 transition focus:outline-none">
          <span class="sr-only">Open navigation menu</span>
          <!-- Hamburger icon -->
          <svg id="hamburger-icon-bars" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg id="hamburger-icon-close" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- ================= MOBILE MENU DRAWER ================= -->
  <div id="mobile-menu" 
       class="hidden md:hidden border-t border-gray-200/90 bg-white/98 backdrop-blur-xl max-h-[calc(100vh-5rem)] overflow-y-auto px-4 pt-3 pb-6 space-y-4 shadow-xl">
    
    <!-- Primary Navigation Links -->
    <div class="space-y-1">
      <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
        <span>🏠</span>
        <span>Home</span>
      <% end %>

      <!-- Mobile Find Doctors Collapsible -->
      <% if can? :read, Specialization %>
        <div>
          <button type="button" 
                  id="mobile-spec-toggle" 
                  class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition">
            <span class="flex items-center gap-3">
              <span>🩺</span>
              <span>Find Doctors</span>
            </span>
            <svg id="mobile-spec-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div id="mobile-spec-sublist" class="hidden pl-9 pr-2 py-1 space-y-1">
            <%= link_to "All Specializations →", specializations_path, class: "block py-1.5 text-xs font-bold text-teal-600 hover:underline" %>
            <% all_specializations.take(8).each do |spec| %>
              <%= link_to spec.name, specialization_path(spec), class: "block py-1.5 text-xs text-gray-600 hover:text-teal-700" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if can? :read, Hospital %>
        <%= link_to hospitals_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
          <span>🏥</span>
          <span>Hospitals</span>
        <% end %>
      <% end %>

      <%= link_to about_us_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
        <span>ℹ️</span>
        <span>About Us</span>
      <% end %>

      <%= link_to contact_us_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
        <span>✉️</span>
        <span>Contact Us</span>
      <% end %>
    </div>

    <!-- Role-Specific Action Links on Mobile -->
    <% if user_signed_in? %>
      <div class="pt-3 border-t border-gray-100 space-y-1">
        <span class="block px-3 text-[10px] font-bold uppercase tracking-wider text-gray-400">Portal Shortcuts</span>

        <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
          <span>📊</span>
          <span>Dashboard</span>
        <% end %>

        <% if current_user.patient? && can?(:read, Appointment) %>
          <%= link_to appointments_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
            <span>📅</span>
            <span>My Appointments</span>
          <% end %>
        <% end %>

        <% if current_user.doctor? && can?(:read, Appointment) %>
          <%= link_to appointments_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
            <span>🕒</span>
            <span>OPD Schedule</span>
          <% end %>
        <% end %>

        <% if current_user.admin? || current_user.staff? %>
          <% if can? :manage, User %>
            <%= link_to staff_management_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
              <span>👥</span>
              <span>Manage Users</span>
            <% end %>
          <% end %>
          <% if can? :read, ContactMessage %>
            <%= link_to contact_messages_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-800 hover:bg-teal-50 hover:text-teal-700 transition" do %>
              <span>📬</span>
              <span>Patient Inquiries</span>
            <% end %>
          <% end %>
        <% end %>

        <%= link_to profile_target_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-teal-700 bg-teal-50/50 hover:bg-teal-50 transition" do %>
          <span>⚙️</span>
          <span>Profile Settings</span>
        <% end %>
      </div>

      <div class="pt-2">
        <%= button_to destroy_user_session_path, method: :delete, 
              class: "w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-xl transition cursor-pointer" do %>
          <span>Sign Out</span>
        <% end %>
      </div>

    <% else %>
      <!-- Guest Action Buttons on Mobile -->
      <div class="pt-3 border-t border-gray-100 space-y-2">
        <%= link_to "Book Consultation", new_user_session_path, 
              class: "block w-full text-center py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow transition" %>
        
        <%= link_to "Sign In to Account", new_user_session_path, 
              class: "block w-full text-center py-2.5 rounded-xl border border-gray-200 text-gray-700 font-semibold text-xs hover:bg-gray-50 transition" %>
      </div>
    <% end %>

  </div>
</header>

<!-- Spacer Div to prevent content from jumping beneath the fixed header -->
<div class="h-20"></div>

<!-- ================= SCRIPT LOGIC ================= -->
<script>
  // 1. Smooth Scroll Header Animation
  function setupHeaderScroll() {
    const header = document.getElementById("site-header");
    if (!header || header.dataset.scrollBound === "true") return;
    header.dataset.scrollBound = "true";

    let lastScrollY = window.scrollY;
    const scrollThreshold = 20;

    window.addEventListener("scroll", () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 10) {
        header.classList.remove("-translate-y-full", "shadow-md");
        header.classList.add("shadow-sm");
        lastScrollY = currentScrollY;
        return;
      }

      // Keep header visible if mobile menu is currently open
      const mobileMenu = document.getElementById("mobile-menu");
      const isMobileMenuOpen = mobileMenu && !mobileMenu.classList.contains("hidden");
      if (isMobileMenuOpen) return;

      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        header.classList.add("-translate-y-full");
      } else if (currentScrollY < lastScrollY - scrollThreshold) {
        header.classList.remove("-translate-y-full");
        header.classList.add("shadow-md");
      }

      lastScrollY = currentScrollY;
    }, { passive: true });
  }

  // 2. Global Resilient Event Delegation (Mobile Menu + Profile Dropdown)
  (function initHeaderNavigation() {
    if (window.headerNavInitialized) return;
    window.headerNavInitialized = true;

    function openProfileMenu(menu, btn) {
      menu.classList.remove("hidden");
      requestAnimationFrame(() => {
        menu.classList.remove("opacity-0", "scale-95");
        menu.classList.add("opacity-100", "scale-100");
      });
      if (btn) btn.setAttribute("aria-expanded", "true");
    }

    function closeProfileMenu(menu, btn) {
      menu.classList.remove("opacity-100", "scale-100");
      menu.classList.add("opacity-0", "scale-95");
      setTimeout(() => {
        menu.classList.add("hidden");
      }, 150);
      if (btn) btn.setAttribute("aria-expanded", "false");
    }

    function toggleMobileMenu(forceClose = false) {
      const mobileMenu = document.getElementById("mobile-menu");
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const iconBars = document.getElementById("hamburger-icon-bars");
      const iconClose = document.getElementById("hamburger-icon-close");

      if (!mobileMenu || !mobileBtn) return;

      const shouldClose = forceClose || !mobileMenu.classList.contains("hidden");

      if (shouldClose) {
        mobileMenu.classList.add("hidden");
        mobileBtn.setAttribute("aria-expanded", "false");
        if (iconBars) iconBars.classList.remove("hidden");
        if (iconClose) iconClose.classList.add("hidden");
      } else {
        mobileMenu.classList.remove("hidden");
        mobileBtn.setAttribute("aria-expanded", "true");
        if (iconBars) iconBars.classList.add("hidden");
        if (iconClose) iconClose.classList.remove("hidden");
      }
    }

    document.addEventListener("click", (e) => {
      const profileBtn = document.getElementById("profile-dropdown-btn");
      const profileMenu = document.getElementById("profile-dropdown-menu");
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const specToggle = document.getElementById("mobile-spec-toggle");

      // 1. Mobile Menu Hamburger Click
      if (mobileBtn && mobileBtn.contains(e.target)) {
        e.preventDefault();
        e.stopPropagation();
        // If profile menu was open, close it
        if (profileMenu && !profileMenu.classList.contains("hidden")) {
          closeProfileMenu(profileMenu, profileBtn);
        }
        toggleMobileMenu();
        return;
      }

      // 2. Mobile Specializations Accordion Toggle
      if (specToggle && specToggle.contains(e.target)) {
        e.preventDefault();
        e.stopPropagation();
        const sublist = document.getElementById("mobile-spec-sublist");
        const chevron = document.getElementById("mobile-spec-chevron");
        if (sublist) {
          sublist.classList.toggle("hidden");
        }
        if (chevron) {
          chevron.classList.toggle("rotate-180");
        }
        return;
      }

      // 3. Profile Avatar Button Click
      if (profileBtn && profileBtn.contains(e.target)) {
        e.preventDefault();
        e.stopPropagation();
        // Close mobile drawer if open
        toggleMobileMenu(true);

        const isClosed = profileMenu.classList.contains("hidden");
        if (isClosed) {
          openProfileMenu(profileMenu, profileBtn);
        } else {
          closeProfileMenu(profileMenu, profileBtn);
        }
        return;
      }

      // 4. Clicked outside Profile Dropdown
      if (profileMenu && !profileMenu.contains(e.target) && !profileMenu.classList.contains("hidden")) {
        closeProfileMenu(profileMenu, profileBtn);
      }

      // 5. Close Mobile Menu when clicking any link inside it
      if (mobileMenu && !mobileMenu.classList.contains("hidden") && mobileMenu.contains(e.target) && e.target.closest("a, button[type='submit']")) {
        toggleMobileMenu(true);
      }
    });

    // Close on Escape Key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const profileMenu = document.getElementById("profile-dropdown-menu");
        const profileBtn = document.getElementById("profile-dropdown-btn");
        if (profileMenu && !profileMenu.classList.contains("hidden")) {
          closeProfileMenu(profileMenu, profileBtn);
        }
        toggleMobileMenu(true);
      }
    });

    // Reset UI before Turbo snapshot cache
    document.addEventListener("turbo:before-cache", () => {
      const profileMenu = document.getElementById("profile-dropdown-menu");
      const profileBtn = document.getElementById("profile-dropdown-btn");
      if (profileMenu) {
        profileMenu.classList.add("hidden", "opacity-0", "scale-95");
        profileMenu.classList.remove("opacity-100", "scale-100");
      }
      if (profileBtn) {
        profileBtn.setAttribute("aria-expanded", "false");
      }
      toggleMobileMenu(true);
    });
  })();

  document.addEventListener("turbo:load", setupHeaderScroll);
  document.addEventListener("DOMContentLoaded", setupHeaderScroll);
</script>