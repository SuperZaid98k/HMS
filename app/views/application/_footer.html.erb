<!-- 3. Lead Capture & Impact Statistics Footer Block -->
<section class="bg-teal-900 text-white pt-14 pb-12 mt-12 border-t border-teal-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Impact Metric Counters -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center border-b border-teal-800/80 pb-12 mb-12">
      <div class="p-4 rounded-xl bg-teal-800/40 border border-teal-700/50">
        <div class="text-3xl sm:text-4xl font-extrabold text-teal-300">15K+</div>
        <div class="text-xs sm:text-sm text-teal-100 mt-1 uppercase tracking-wider font-medium">Patients Assisted</div>
      </div>
      <div class="p-4 rounded-xl bg-teal-800/40 border border-teal-700/50">
        <div class="text-3xl sm:text-4xl font-extrabold text-teal-300">50+</div>
        <div class="text-xs sm:text-sm text-teal-100 mt-1 uppercase tracking-wider font-medium">Cities & Regions</div>
      </div>
      <div class="p-4 rounded-xl bg-teal-800/40 border border-teal-700/50">
        <div class="text-3xl sm:text-4xl font-extrabold text-teal-300">150+</div>
        <div class="text-xs sm:text-sm text-teal-100 mt-1 uppercase tracking-wider font-medium">Partner Hospitals</div>
      </div>
      <div class="p-4 rounded-xl bg-teal-800/40 border border-teal-700/50">
        <div class="text-3xl sm:text-4xl font-extrabold text-teal-300">24hr</div>
        <div class="text-xs sm:text-sm text-teal-100 mt-1 uppercase tracking-wider font-medium">Response Time</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Quick Lead Inquire Form -->
      <div class="lg:col-span-5 bg-teal-800/50 p-6 sm:p-8 rounded-2xl border border-teal-700 shadow-inner">
        <h3 class="text-xl font-bold text-white mb-1">Find the Right Care for Your Health</h3>
        <p class="text-xs text-teal-200 mb-6">Get guidance on doctors, hospitals, and treatment costs.</p>

        <%= form_with(model: (@contact_message || ContactMessage.new), url: (defined?(contact_us_path) ? contact_us_path : "#"), class: "space-y-4") do |f| %>
          <div>
            <%= f.text_field :name, placeholder: "Full Name *", required: true,
                  class: "w-full rounded-lg bg-teal-900/60 border border-teal-600 px-3 py-2 text-sm text-white placeholder-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-400" %>
          </div>

          <div>
            <%= f.telephone_field :contact_no, placeholder: "Contact Number *", required: true,
                  class: "w-full rounded-lg bg-teal-900/60 border border-teal-600 px-3 py-2 text-sm text-white placeholder-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-400" %>
          </div>

          <div>
            <%= f.email_field :email, placeholder: "Email Address *", required: true,
                  class: "w-full rounded-lg bg-teal-900/60 border border-teal-600 px-3 py-2 text-sm text-white placeholder-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-400" %>
          </div>

          <div>
            <%= f.text_area :message, rows: 3, placeholder: "Describe your medical concern...",
                  class: "w-full rounded-lg bg-teal-900/60 border border-teal-600 px-3 py-2 text-sm text-white placeholder-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-400" %>
          </div>

          <%= f.submit "Request Guidance", 
                class: "w-full py-2.5 px-4 bg-white text-teal-900 font-bold rounded-lg hover:bg-teal-50 shadow transition cursor-pointer text-sm" %>
          
          <p class="text-[11px] text-teal-300 text-center mt-2 flex items-center justify-center gap-1">
            🔒 Your information is 100% confidential
          </p>
        <% end %>
      </div>

      <!-- Directory Links -->
      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-6 text-sm">
        <div>
          <h4 class="font-semibold text-white uppercase tracking-wider text-xs mb-3 border-b border-teal-700 pb-1">Corporate</h4>
          <ul class="space-y-2 text-teal-200 text-xs sm:text-sm">
            <li><%= link_to "About Us", about_us_path, class: "hover:text-white transition" %></li>
            <li><%= link_to "Contact Us", (defined?(contact_us_path) ? contact_us_path : "#"), class: "hover:text-white transition" %></li>
            <li><%= link_to "Our Hospitals", (defined?(hospitals_path) ? hospitals_path : "#"), class: "hover:text-white transition" %></li>
            <li><%= link_to "Specializations", (defined?(specializations_path) ? specializations_path : "#"), class: "hover:text-white transition" %></li>
            <%= link_to partner_with_us_path, class: "inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-bold transition" do %>
            <span>+ List Your Hospital</span>
            <span class="px-1.5 py-0.5 rounded text-[9px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Apply</span>
          <% end %>
          </ul>
        </div>

        <div>
          <h4 class="font-semibold text-white uppercase tracking-wider text-xs mb-3 border-b border-teal-700 pb-1">For Patients</h4>
          <ul class="space-y-2 text-teal-200 text-xs sm:text-sm">
            <li><%= link_to "Book Appointment", (defined?(new_appointment_path) ? new_appointment_path : "#"), class: "hover:text-white transition" %></li>
            <li><%= link_to "Doctors Directory", (defined?(doctor_profiles_path) ? doctor_profiles_path : "#"), class: "hover:text-white transition" %></li>
            <li><%= link_to "Patient Portal", (defined?(dashboard_path) ? dashboard_path : "#"), class: "hover:text-white transition" %></li>
          </ul>
        </div>
        

        <div>
          <h4 class="font-semibold text-white uppercase tracking-wider text-xs mb-3 border-b border-teal-700 pb-1">Top Specialities</h4>
          <ul class="space-y-2 text-teal-200 text-xs sm:text-sm">
            <li><span class="hover:text-white cursor-pointer transition">Cardiology</span></li>
            <li><span class="hover:text-white cursor-pointer transition">Orthopedics</span></li>
            <li><span class="hover:text-white cursor-pointer transition">Neurology</span></li>
            <li><span class="hover:text-white cursor-pointer transition">Oncology</span></li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Footer Copyright Strip -->
    <div class="border-t border-teal-800/80 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-teal-300 gap-4">
      <p>&copy; <%= Time.current.year %> Hospital Management System. All rights reserved.</p>
      <div class="flex gap-4">
        <span class="hover:text-white cursor-pointer">Terms & Conditions</span>
        <span class="hover:text-white cursor-pointer">Privacy Policy</span>
        <span class="hover:text-white cursor-pointer">Medical Disclaimer</span>
      </div>
    </div>

  </div>
</section>