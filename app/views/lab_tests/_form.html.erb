<%= form_with(model: lab_test, class: "needs-validation") do |form| %>
  <% if lab_test.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(lab_test.errors.count, "error") %> prohibited this lab test from being saved:</h5>
      <ul class="mb-0">
        <% lab_test.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :test_name, "Test Name", class: "form-label" %>
    <%= form.text_field :test_name, class: "form-control", placeholder: "e.g. Complete Blood Count (CBC), Lipid Panel" %>
  </div>

  <div class="mb-3">
    <%= form.label :patient_id, "Select Patient", class: "form-label" %>
    <%= form.collection_select :patient_id, Patient.all, :id, ->(p) { p.patient_profile ? "#{p.patient_profile.first_name} #{p.patient_profile.last_name} (#{p.patient_number})" : "Patient ##{p.patient_number}" }, { prompt: "-- Select Patient --" }, { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.label :doctor_profile_id, "Ordering Doctor", class: "form-label" %>
    <%= form.collection_select :doctor_profile_id, DoctorProfile.all, :id, ->(d) { "Dr. #{d.name} (#{d.department&.name})" }, { prompt: "-- Select Doctor --" }, { class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= form.label :requested_at, "Requested Date & Time", class: "form-label" %>
    <%= form.text_field :requested_at, class: "form-control", value: lab_test.requested_at || Time.current.strftime("%Y-%m-%d %H:%M") %>
  </div>

  <div class="mb-3">
    <%= form.label :status, "Status", class: "form-label" %>
    <%= form.select :status, ["pending", "done"], { prompt: "-- Select Status --" }, { class: "form-control" } %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", lab_tests_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
