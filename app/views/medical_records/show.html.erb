<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Medical Record #<%= @medical_record.id %></h1>
    <div class="d-flex gap-2">
      <% if can? :create, Prescription %>
        <%= link_to "+ Create Prescription", new_prescription_path(medical_record_id: @medical_record.id, patient_id: @medical_record.patient_id, doctor_profile_id: @medical_record.doctor_profile_id), class: "btn btn-primary" %>
      <% end %>
      <% if can? :update, @medical_record %>
        <%= link_to "Edit Record", edit_medical_record_path(@medical_record), class: "btn btn-warning" %>
      <% end %>
      <%= link_to "Back to Records", medical_records_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>


  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      Record Details
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-sm-3 fw-semibold">Patient:</div>
        <div class="col-sm-9 mb-3">
          <% if @medical_record.patient&.patient_profile %>
            <%= link_to "#{@medical_record.patient.patient_profile.first_name} #{@medical_record.patient.patient_profile.last_name}", patient_path(@medical_record.patient) %>
          <% else %>
            Patient #<%= @medical_record.patient_id %>
          <% end %>
        </div>

        <div class="col-sm-3 fw-semibold">Attending Doctor:</div>
        <div class="col-sm-9 mb-3">
          <% if @medical_record.doctor_profile %>
            <%= link_to "Dr. #{@medical_record.doctor_profile.name}", doctor_profile_path(@medical_record.doctor_profile) %>
          <% else %>
            N/A
          <% end %>
        </div>

        <div class="col-sm-3 fw-semibold">Diagnosis:</div>
        <div class="col-sm-9 mb-3"><strong class="fs-5 text-primary"><%= @medical_record.diagnosis %></strong></div>

        <div class="col-sm-3 fw-semibold">Clinical Description:</div>
        <div class="col-sm-9 mb-3"><%= @medical_record.description.presence || "No description recorded" %></div>
      </div>
    </div>
  </div>

  <!-- Assigned Treatments Section -->
  <div class="card mb-4">
    <div class="card-header">
      Assigned Treatments (<%= @medical_record.treatment_assignments.count %>)
    </div>
    <div class="card-body">
      <% if @medical_record.treatment_assignments.any? %>
        <table class="table table-striped table-hover align-middle mb-4">
          <thead class="table-dark">
            <tr>
              <th>Treatment Name</th>
              <th>Started At</th>
              <th>Completed At</th>
              <th>Notes</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @medical_record.treatment_assignments.each do |ta| %>
              <tr>
                <td><strong><%= ta.treatment&.name || "Treatment ##{ta.treatment_id}" %></strong></td>
                <td><%= ta.started_at || "-" %></td>
                <td><%= ta.completed_at || "-" %></td>
                <td><%= ta.notes %></td>
                <td class="text-end">
                  <% if can? :destroy, ta %>
                    <%= button_to "Remove", medical_record_treatment_assignment_path(@medical_record, ta), 
                                  method: :delete, 
                                  class: "btn btn-sm btn-danger",
                                  data: { turbo_confirm: "Remove this treatment assignment?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No treatments assigned to this record yet.</p>
      <% end %>

      <!-- Assign Treatment Form -->
      <% if can? :create, TreatmentAssignment %>
        <div class="card bg-light p-3">
          <h5 class="mb-3">Assign New Treatment</h5>
          <%= form_with(model: [@medical_record, @medical_record.treatment_assignments.build]) do |f| %>
            <div class="row">
              <div class="col-sm-4 mb-3">
                <%= f.label :treatment_id, "Select Treatment", class: "form-label" %>
                <%= f.collection_select :treatment_id, Treatment.all, :id, :name, { prompt: "-- Select Treatment --" }, { class: "form-control" } %>
              </div>
              <div class="col-sm-4 mb-3">
                <%= f.label :started_at, "Start Date", class: "form-label" %>
                <%= f.date_field :started_at, class: "form-control" %>
              </div>
              <div class="col-sm-4 mb-3">
                <%= f.label :completed_at, "End / Completion Date", class: "form-label" %>
                <%= f.date_field :completed_at, class: "form-control" %>
              </div>
            </div>
            <div class="mb-3">
              <%= f.label :notes, "Treatment Notes", class: "form-label" %>
              <%= f.text_field :notes, class: "form-control", placeholder: "e.g. 3 sessions per week" %>
            </div>
            <%= f.submit "Assign Treatment", class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
