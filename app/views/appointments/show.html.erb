<%
  patient_profile = @appointment.patient&.patient_profile
  patient_name = patient_profile ? "#{patient_profile.first_name} #{patient_profile.last_name}" : "Patient ##{@appointment.patient_id}"
  doctor_name = @appointment.doctor_profile ? "Dr. #{@appointment.doctor_profile.name}" : "Unassigned Doctor"

  status_badge_classes = case @appointment.status.to_s.downcase
  when "confirmed"
    "bg-emerald-50 text-emerald-700 border-emerald-200"
  when "completed"
    "bg-blue-50 text-blue-700 border-blue-200"
  when "cancelled"
    "bg-rose-50 text-rose-700 border-rose-200"
  else
    "bg-amber-50 text-amber-700 border-amber-200"
  end
%>

<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Top Navigation & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-6 rounded-full bg-teal-600 inline-block"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Consultation Itinerary</span>
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
            Appointment #<%= @appointment.id %>
          </h1>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border <%= status_badge_classes %>">
            ● <%= @appointment.status.presence || "Scheduled" %>
          </span>
        </div>
      </div>

      <!-- Action Controls -->
      <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-center">
        <% if can? :update, @appointment %>
          <%= link_to edit_appointment_path(@appointment), class: "px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow-sm transition" do %>
            ✏️ Edit Details
          <% end %>
        <% end %>

        <%= link_to appointments_path, class: "px-4 py-2 rounded-xl bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-xs font-semibold shadow-sm transition" do %>
          ← All Appointments
        <% end %>
      </div>
    </div>

    <!-- Appointment Overview Card -->
    <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm p-6 sm:p-8 space-y-6">
      
      <!-- Patient & Doctor Quick-View Strip -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-6 border-b border-gray-100">
        <!-- Patient Identity -->
        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-50 border border-gray-100">
          <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white flex items-center justify-center font-bold text-base shadow-sm flex-shrink-0">
            <%= patient_profile ? "#{patient_profile.first_name[0]}#{patient_profile.last_name[0]}".upcase : "P" %>
          </div>
          <div class="min-w-0">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-teal-700">Patient</span>
            <p class="text-sm font-bold text-gray-900 truncate"><%= patient_name %></p>
            <p class="text-xs text-gray-500 font-mono">
              <%= @appointment.patient&.patient_number || "ID ##{@appointment.patient_id}" %>
              <% if patient_profile&.phone.present? %> &bull; <%= patient_profile.phone %><% end %>
            </p>
          </div>
        </div>

        <!-- Doctor Identity -->
        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-50 border border-gray-100">
          <div class="w-12 h-12 rounded-2xl bg-cyan-700 text-white flex items-center justify-center font-bold text-base shadow-sm flex-shrink-0">
            🩺
          </div>
          <div class="min-w-0">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-cyan-700">Specialist Clinician</span>
            <p class="text-sm font-bold text-gray-900 truncate"><%= doctor_name %></p>
            <p class="text-xs text-gray-500 truncate">
              <%= @appointment.doctor_profile&.department&.name || "Outpatient Department" %>
            </p>
          </div>
        </div>
      </div>

      <!-- Schedule & Details Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
        <div>
          <span class="text-gray-400 block mb-1 font-semibold uppercase tracking-wider text-[10px]">Scheduled Date & Time</span>
          <span class="font-bold text-gray-900 text-sm">
            <%= @appointment.scheduled_at.try(:strftime, "%B %d, %Y") || "-" %>
          </span>
          <p class="text-xs font-semibold text-teal-700 mt-0.5">
            <%= @appointment.scheduled_at.try(:strftime, "%I:%M %p") || "Time not specified" %>
          </p>
        </div>

        <div>
          <span class="text-gray-400 block mb-1 font-semibold uppercase tracking-wider text-[10px]">Blood Type</span>
          <span class="font-bold text-rose-600 text-sm">
            <%= patient_profile&.blood_group.presence || "Not specified" %>
          </span>
        </div>

        <div>
          <span class="text-gray-400 block mb-1 font-semibold uppercase tracking-wider text-[10px]">Created On</span>
          <span class="font-semibold text-gray-700 text-sm">
            <%= @appointment.created_at.strftime("%b %d, %Y") %>
          </span>
        </div>
      </div>

      <!-- Reason for Consultation -->
      <div class="pt-4 border-t border-gray-100">
        <span class="text-gray-400 block mb-1.5 font-semibold uppercase tracking-wider text-[10px]">Reason for Visit / Symptoms</span>
        <div class="p-4 rounded-2xl bg-teal-50/50 border border-teal-100 text-sm text-gray-800 leading-relaxed">
          <%= @appointment.reason.presence || "General clinical checkup and routine consultation." %>
        </div>
      </div>

    </div>

    <!-- Appointment Notes & Clinical Observations -->
    <% if can? :read, AppointmentNote %>
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-slate-50/50">
          <div>
            <h3 class="text-base font-bold text-gray-900">Clinical Observations & Follow-ups</h3>
            <p class="text-xs text-gray-500">Doctor progress notes, prescription remarks, and treatment follow-ups</p>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-800 border border-teal-100">
            <%= @appointment.appointment_notes.size %> Notes
          </span>
        </div>

        <div class="p-6 sm:p-8 space-y-6">
          <!-- Existing Notes List -->
          <% if @appointment.appointment_notes.any? %>
            <div class="space-y-4">
              <% @appointment.appointment_notes.each do |note| %>
                <div class="p-4 rounded-2xl bg-slate-50 border border-gray-200/80 flex items-start justify-between gap-4">
                  <div class="space-y-1">
                    <p class="text-sm text-gray-800 leading-relaxed font-medium"><%= note.content %></p>
                    <span class="inline-flex items-center gap-1.5 text-[11px] text-gray-400 font-mono">
                      <span>🕒</span>
                      <span>Recorded on <%= note.created_at.strftime("%b %d, %Y at %I:%M %p") %></span>
                    </span>
                  </div>

                  <% if can? :destroy, note %>
                    <%= button_to appointment_appointment_note_path(@appointment, note), 
                                  method: :delete, 
                                  class: "text-red-500 hover:text-red-700 text-xs font-semibold px-2 py-1 rounded-lg hover:bg-red-50 transition cursor-pointer", 
                                  data: { turbo_confirm: "Are you sure you want to delete this clinical note?" } do %>
                      Delete
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-6 text-center text-xs text-gray-400 bg-slate-50/50 rounded-2xl border border-dashed border-gray-200">
              No clinical notes recorded for this consultation yet.
            </div>
          <% end %>

          <!-- Add Note Form (Doctors and Admins) -->
          <% if can? :create, AppointmentNote %>
            <div class="pt-4 border-t border-gray-100">
              <h4 class="text-xs font-bold uppercase tracking-wider text-teal-700 mb-3 flex items-center gap-1.5">
                <span>📝</span> Add Clinical Note / Observation
              </h4>
              <%= form_with(model: [@appointment, @appointment.appointment_notes.build], class: "space-y-3") do |f| %>
                <%= f.text_area :content, 
                      rows: 3, 
                      placeholder: "Enter clinical diagnosis notes, prescription directives, or subsequent review instructions...", 
                      class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400",
                      required: true %>
                
                <div class="flex justify-end">
                  <%= f.submit "Save Note", 
                        class: "px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs shadow-sm hover:shadow transition transform hover:-translate-y-0.5 cursor-pointer" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>