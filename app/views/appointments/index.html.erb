<div class="min-h-screen bg-slate-50 py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- 1. Header Banner -->
    <div class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 rounded-3xl p-6 sm:p-10 text-white shadow-lg relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-teal-100 border border-white/20 uppercase tracking-wider mb-3">
            Outpatient Department
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Appointment Directory
          </h1>
          <p class="text-teal-100 text-sm sm:text-base mt-1 max-w-xl">
            Track real-time OPD visits, consultation statuses, assigned clinicians, and patient charts.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <span class="px-4 py-2 bg-white/10 border border-white/20 rounded-xl text-xs font-bold text-teal-100 backdrop-blur-sm">
            Total: <%= @appointments.size %> Appointments
          </span>

          <% if can? :create, Appointment %>
            <%= link_to new_appointment_path, 
                  class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-teal-900 font-bold text-xs sm:text-sm hover:bg-teal-50 shadow-md transition transform hover:-translate-y-0.5" do %>
              <span>+ Book Appointment</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 2. Live Client-Side Search & Filter Bar -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-gray-200/90 shadow-sm flex flex-col sm:flex-row gap-4 justify-between items-center">
      <div class="relative w-full sm:w-96">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
          🔍
        </span>
        <input type="text" 
               id="appointmentSearchInput" 
               placeholder="Search by patient, doctor, ID, or status..." 
               class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-slate-50 transition" />
      </div>

      <div class="flex items-center gap-2 text-xs text-gray-500 font-medium self-end sm:self-center">
        <span>✓ Instant Confirmation</span>
        <span>&bull;</span>
        <span>✓ Live OPD Routing</span>
      </div>
    </div>

    <!-- 3. Appointments Table Card -->
    <% if @appointments.present? %>
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-200/80 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-4 px-6">Token</th>
                <th class="py-4 px-6">Status</th>
                <th class="py-4 px-6">Patient</th>
                <th class="py-4 px-6">Consulting Doctor</th>
                <th class="py-4 px-6">Scheduled Date & Time</th>
                <th class="py-4 px-6">Reason</th>
                <th class="py-4 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="appointmentsTableBody" class="divide-y divide-gray-100">
              <% @appointments.each do |appointment| %>
                <%
                  patient_profile = appointment.patient&.patient_profile
                  patient_name = patient_profile ? "#{patient_profile.first_name} #{patient_profile.last_name}" : "Patient ##{appointment.patient_id}"
                  doctor_name = appointment.doctor_profile ? "Dr. #{appointment.doctor_profile.name}" : "Unassigned"
                  search_data = "#{appointment.id} #{patient_name} #{doctor_name} #{appointment.status} #{appointment.reason}".downcase

                  status_classes = case appointment.status.to_s.downcase
                  when "confirmed" then "bg-emerald-50 text-emerald-700 border-emerald-200"
                  when "completed" then "bg-blue-50 text-blue-700 border-blue-200"
                  when "cancelled" then "bg-rose-50 text-rose-700 border-rose-200"
                  else "bg-amber-50 text-amber-700 border-amber-200"
                  end
                %>
                <tr class="appointment-row hover:bg-teal-50/40 transition group" data-searchable="<%= search_data %>">
                  
                  <!-- Token ID -->
                  <td class="py-4 px-6 font-mono font-bold text-teal-800">
                    <div class="flex items-center gap-2">
                      <span class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center text-xs font-bold border border-teal-100">
                        #
                      </span>
                      <span><%= appointment.id %></span>
                    </div>
                  </td>

                  <!-- Status -->
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider border <%= status_classes %>">
                      <%= appointment.status.presence || "Scheduled" %>
                    </span>
                  </td>

                  <!-- Patient Name -->
                  <td class="py-4 px-6">
                    <div class="font-semibold text-slate-900 leading-snug"><%= patient_name %></div>
                    <span class="text-xs text-gray-400 font-mono"><%= appointment.patient&.patient_number %></span>
                  </td>

                  <!-- Doctor Name -->
                  <td class="py-4 px-6">
                    <div class="font-semibold text-slate-800"><%= doctor_name %></div>
                    <span class="text-xs text-gray-500"><%= appointment.doctor_profile&.department&.name || "Outpatient" %></span>
                  </td>

                  <!-- Scheduled Time -->
                  <td class="py-4 px-6 text-xs text-gray-600">
                    <span class="font-bold text-gray-900 block"><%= appointment.scheduled_at.try(:strftime, "%b %d, %Y") || "-" %></span>
                    <span><%= appointment.scheduled_at.try(:strftime, "%I:%M %p") %></span>
                  </td>

                  <!-- Reason -->
                  <td class="py-4 px-6 text-xs text-gray-600 max-w-xs truncate">
                    <%= appointment.reason.presence || "General consultation" %>
                  </td>

                  <!-- Action Buttons -->
                  <td class="py-4 px-6 text-right">
                    <div class="flex items-center justify-end gap-2 text-xs">
                      <% if can? :read, appointment %>
                        <%= link_to "Details", appointment_path(appointment), 
                              class: "px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-600 text-teal-700 hover:text-white font-semibold transition border border-teal-200" %>
                      <% end %>

                      <% if can? :update, appointment %>
                        <%= link_to "Edit", edit_appointment_path(appointment), 
                              class: "text-amber-600 hover:text-amber-700 font-medium hover:underline px-1" %>
                      <% end %>

                      <% if can? :destroy, appointment %>
                        <%= button_to "Delete", appointment_path(appointment), 
                              method: :delete, 
                              class: "text-red-600 hover:text-red-700 font-medium hover:underline bg-transparent border-0 p-0 text-xs cursor-pointer", 
                              data: { turbo_confirm: "Are you sure you want to cancel and delete appointment ##{appointment.id}?" } %>
                      <% end %>
                    </div>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- No Matching Filter Results -->
      <div id="noAppointmentsFound" class="hidden p-12 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500">
        <span class="text-3xl block mb-2">🔍</span>
        <p class="font-bold text-gray-800">No matching appointments found</p>
        <p class="text-xs text-gray-500">Try adjusting your search criteria by patient name, doctor, or ID token.</p>
      </div>

    <% else %>
      <!-- Zero State -->
      <div class="p-16 text-center bg-white rounded-3xl border border-dashed border-gray-300 text-gray-500 space-y-4">
        <span class="text-4xl block">📅</span>
        <h3 class="text-lg font-bold text-gray-800">No Appointments Recorded</h3>
        <p class="text-sm text-gray-500 max-w-sm mx-auto">
          No medical consultations are scheduled in the system yet.
        </p>
        <% if can? :create, Appointment %>
          <%= link_to "+ Book First Appointment", new_appointment_path, class: "inline-block px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow transition" %>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<script>
  function setupAppointmentFilter() {
    const input = document.getElementById("appointmentSearchInput");
    const rows = document.querySelectorAll(".appointment-row");
    const noResults = document.getElementById("noAppointmentsFound");

    if (!input || rows.length === 0) return;

    input.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      rows.forEach((row) => {
        const data = row.getAttribute("data-searchable") || "";
        if (data.includes(query)) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    });
  }

  document.addEventListener("turbo:load", setupAppointmentFilter);
  document.addEventListener("DOMContentLoaded", setupAppointmentFilter);
</script>