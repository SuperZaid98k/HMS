<%= form_with(model: appointment, class: "space-y-6") do |form| %>
  
  <!-- Error Summary Block -->
  <% if appointment.errors.any? %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
      <div class="flex items-center gap-2 font-bold mb-1">
        <span>⚠️</span>
        <span><%= pluralize(appointment.errors.count, "error") %> prohibited this appointment from being scheduled:</span>
      </div>
      <ul class="list-disc list-inside space-y-0.5 ml-4">
        <% appointment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- SECTION 1: Patient Details -->
  <div>
    <% if current_user.patient? %>
      <!-- Auto-Linked Patient Identity Badge -->
      
      <div class="p-4 rounded-2xl bg-slate-50 border border-gray-200/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-sm">
            👤
          </div>
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Booking For Patient</span>
            <span class="text-sm font-bold text-gray-900">
              <%= current_user.patient&.patient_profile&.first_name || current_user.name || current_user.email.split('@').first.capitalize %>
              <%= current_user.patient&.patient_profile&.last_name %>
            </span>
          </div>
        </div>
        <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-lg bg-white border border-gray-200 text-gray-600">
          <%= current_user.patient&.patient_number || "PAT-REG" %>
        </span>
      </div>

    <% else %>
      <!-- Admin / Staff Patient Selector -->
      <div>
        <%= form.label :patient_id, "Select Patient *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= form.collection_select :patient_id,
              Patient.includes(:patient_profile).order(:created_at),
              :id, 
              ->(p) { p.patient_profile ? "#{p.patient_profile.first_name} #{p.patient_profile.last_name} (#{p.patient_number})" : "Patient ##{p.patient_number || p.id}" }, 
              { prompt: "-- Choose Patient Record --" }, 
              { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition", required: true } %>
      </div>
    <% end %>
  </div>

  <!-- SECTION 2: Doctor Selection -->
  <div>
    <%= form.label :doctor_profile_id, "Consulting Specialist *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
    <%= form.collection_select :doctor_profile_id, 
          DoctorProfile.includes(:department).all, 
          :id, 
          ->(doctor) { "Dr. #{doctor.name.presence || doctor.user&.name || "Specialist"} — #{doctor.department&.name || 'General Medicine'}" }, 
          { prompt: "-- Select Medical Specialist --", selected: appointment.doctor_profile_id }, 
          { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition", required: true } %>
    <p class="text-[11px] text-gray-400 mt-1">Select the doctor assigned for this clinical consultation</p>
  </div>

  <!-- SECTION 3: Date & Time and Status -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Scheduled At -->
    <div class="<%= current_user.patient? ? 'sm:col-span-2' : '' %>">
      <%= form.label :scheduled_at, "Date & Time *", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
      <%= form.datetime_local_field :scheduled_at, 
            value: appointment.scheduled_at.try(:strftime, "%Y-%m-%dT%H:%M") || appointment.scheduled_at, 
            min: Time.current.strftime("%Y-%m-%dT%H:%M"),
            class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition",
            required: true %>
      <p class="text-[11px] text-gray-400 mt-1">Available OPD hours: 09:00 AM - 07:00 PM</p>
    </div>

    <!-- Status Field (Staff/Doctor/Admin Only) -->
    <% unless current_user.patient? %>
      <div>
        <%= form.label :status, "Appointment Status", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
        <%= form.select :status, 
              [["Scheduled", "scheduled"], ["Confirmed", "confirmed"], ["Completed", "completed"], ["Cancelled", "cancelled"]], 
              { prompt: "-- Set Initial Status --" }, 
              { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition" } %>
      </div>
    <% end %>
  </div>

  <!-- SECTION 4: Reason / Symptoms -->
  <div>
    <%= form.label :reason, "Symptoms / Visit Reason", class: "block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1" %>
    <%= form.text_area :reason, 
          rows: 3, 
          placeholder: "Briefly explain the medical concern, ongoing symptoms, or regular review...", 
          class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm bg-slate-50/50 outline-none transition placeholder-gray-400" %>
  </div>

  <!-- Form Actions -->
  <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
    <%= form.submit (appointment.new_record? ? "Confirm & Book Appointment" : "Update Appointment Details"), 
          class: "w-full sm:w-auto px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5 cursor-pointer" %>
    
    <%= link_to "Cancel", appointments_path, 
          class: "w-full sm:w-auto text-center px-5 py-2.5 rounded-xl border border-gray-200 hover:bg-gray-50 text-gray-600 font-semibold text-xs transition" %>
  </div>

<% end %>