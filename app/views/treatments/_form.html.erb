<%= form_with(model: treatment, class: "needs-validation") do |form| %>
  <% if treatment.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(treatment.errors.count, "error") %> prohibited this treatment from being saved:</h5>
      <ul class="mb-0">
        <% treatment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "e.g. City Care treatment" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Description", class: "form-label" %>
    <%= form.text_field :description, class: "form-control"  %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", treatments_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>