
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>treatment List</h1>
    <% if can? :create, Treatment %>
      <%= link_to "Create treatment", new_treatment_path, class: "btn btn-primary" %>
    <% end %>
  </div>


  <% if @treatments.any? %>
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Description</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @treatments.each do |treatment| %>
          <tr>
            <td><%= treatment.id %></td>
            <td><strong><%= treatment.name %></strong></td>
            <td><%= treatment.description %></td>
            <td class="text-end">
              <!-- treatment Details -->
              <% if can? :read, treatment %>
                <%= link_to "Details", treatment_path(treatment), class: "btn btn-sm btn-info text-white me-1" %>
              <% end %>
              
              <!-- Edit treatment -->
              <% if can? :update, treatment %>
                <%= link_to "Edit", edit_treatment_path(treatment), class: "btn btn-sm btn-warning me-1" %>
              <% end %>
              
              <!-- Delete treatment -->
              <% if can? :destroy, treatment %>
                <%= button_to "Delete", treatment_path(treatment), 
                              method: :delete, 
                              class: "btn btn-sm btn-danger d-inline", 
                              form: { style: "display:inline-block;" },
                              data: { turbo_confirm: "Are you sure you want to delete #{treatment.name}?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="alert alert-info">
      No treatments found. Click "Create treatment" to add one.
    </div>
  <% end %>
</div>