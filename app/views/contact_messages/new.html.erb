<div class="min-h-screen bg-slate-50 space-y-12 pb-20">

  <!-- ================= 1. HERO BANNER ================= -->
  <section class="relative bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 text-white rounded-3xl overflow-hidden shadow-xl mx-4 sm:mx-6 lg:mx-8 mt-4">
    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -top-20 w-96 h-96 bg-cyan-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-12 sm:py-16 lg:px-12 text-center space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 text-teal-100 text-xs font-semibold uppercase tracking-wider backdrop-blur-md border border-white/20">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        24/7 Patient Assistance
      </span>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Get in Touch With Our Care Team
      </h1>

      <p class="text-teal-100 text-sm sm:text-base max-w-2xl mx-auto font-normal leading-relaxed">
        Have questions about appointments, specialist doctors, hospital admissions, or diagnostic reports? Send us an inquiry or connect via our direct helpline.
      </p>
    </div>
  </section>

  <!-- ================= 2. MAIN 2-COLUMN SECTION ================= -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN: HOSPITAL DETAILS & CONTACT CHANNELS -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Emergency Hotline Card -->
        <div class="bg-gradient-to-br from-rose-500 to-red-600 rounded-2xl p-6 text-white shadow-md relative overflow-hidden">
          <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
          
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-white text-red-600 uppercase tracking-wider">Emergency 24x7</span>
            <span class="text-xs text-red-100">Immediate Ambulance & Trauma</span>
          </div>
          
          <h3 class="text-2xl font-black tracking-tight mt-1">+91 (0712) 280-4500</h3>
          <p class="text-xs text-red-100 mt-1">Dedicated trauma center, ICU beds, and emergency surgery dispatch.</p>
        </div>

        <!-- Main Campus & Helpdesk Details -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm space-y-5">
          <h3 class="text-base font-bold text-gray-900 border-b border-gray-100 pb-3 flex items-center gap-2">
            <span class="w-2 h-5 rounded-full bg-teal-600 inline-block"></span>
            Hospital Headquarters
          </h3>

          <ul class="space-y-4 text-sm text-gray-600">
            <!-- Address -->
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center flex-shrink-0 text-base font-bold">
                📍
              </div>
              <div>
                <strong class="text-gray-900 block text-xs uppercase tracking-wide">Main Campus Address</strong>
                <span>HMS Super Specialty Hospital, Central Avenue, Medical District, Suite 400</span>
              </div>
            </li>

            <!-- General Inquiries -->
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center flex-shrink-0 text-base font-bold">
                📞
              </div>
              <div>
                <strong class="text-gray-900 block text-xs uppercase tracking-wide">OPD & General Reception</strong>
                <a href="tel:+919876543210" class="text-teal-700 hover:underline font-semibold">+91 98765 43210</a> / +91 (0712) 280-4501
              </div>
            </li>

            <!-- Email -->
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center flex-shrink-0 text-base font-bold">
                ✉️
              </div>
              <div>
                <strong class="text-gray-900 block text-xs uppercase tracking-wide">Official Support Email</strong>
                <a href="mailto:support@hmshospital.org" class="text-teal-700 hover:underline font-semibold">care@hmshospital.org</a>
              </div>
            </li>

            <!-- Working Hours -->
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center flex-shrink-0 text-base font-bold">
                ⏰
              </div>
              <div>
                <strong class="text-gray-900 block text-xs uppercase tracking-wide">Visiting & OPD Hours</strong>
                <span class="block">Mon – Sat: 08:00 AM – 08:00 PM</span>
                <span class="block text-xs text-gray-400">Emergency & Pharmacy: Open 24 Hours / 365 Days</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Visual Map Preview Card -->
        <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <div class="relative h-44 w-full bg-slate-200">
            <!-- Simulated Map Visual -->
            <img src="https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=800&q=80" 
                 alt="Hospital Location Map" 
                 class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-teal-950/30 backdrop-blur-[0.5px]"></div>
            
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
              <span class="text-2xl mb-1">🏥</span>
              <span class="bg-white/95 text-slate-900 text-xs font-bold px-3 py-1 rounded-full shadow">
                HMS Central Medical Complex
              </span>
              <span class="text-[11px] text-white mt-1 drop-shadow">Convenient Metro & Bus Station Access</span>
            </div>
          </div>
          <div class="p-3 bg-slate-50 border-t border-gray-100 text-center">
            <span class="text-xs font-semibold text-teal-700">Valet Parking & Wheelchair Assistance Available at Gate 1</span>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: THE FORM -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 sm:p-10">
          <div class="mb-6 border-b border-gray-100 pb-5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-600 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-100">
              Online Inquiry Form
            </span>
            <h2 class="text-2xl font-bold text-gray-900 tracking-tight mt-2">Send Us a Direct Message</h2>
            <p class="text-gray-500 text-xs sm:text-sm mt-1">Our hospital administration desk typically responds within 15–30 minutes.</p>
          </div>

          <%= render "form", contact_message: @contact_message %>
        </div>
      </div>

    </div>
  </div>

  <!-- ================= 3. FREQUENTLY ASKED QUESTIONS ================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <div class="text-center mb-8">
      <h3 class="text-2xl font-bold text-gray-900">Frequently Asked Questions</h3>
      <p class="text-xs sm:text-sm text-gray-500 mt-1">Quick answers to common inquiries before submitting your form</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-2">
        <h4 class="font-bold text-sm text-gray-900 flex items-center gap-1.5">
          <span class="text-teal-600 font-bold">Q.</span> How do I schedule an emergency appointment?
        </h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          For critical medical conditions, please bypass online booking and call our direct 24x7 emergency line at <strong>+91 (0712) 280-4500</strong>.
        </p>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-2">
        <h4 class="font-bold text-sm text-gray-900 flex items-center gap-1.5">
          <span class="text-teal-600 font-bold">Q.</span> Are insurance and cashless claims accepted?
        </h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          Yes, our billing department supports all major third-party administrators (TPAs), government health schemes, and cashless corporate insurances.
        </p>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-2">
        <h4 class="font-bold text-sm text-gray-900 flex items-center gap-1.5">
          <span class="text-teal-600 font-bold">Q.</span> Where do I collect pathology/lab reports?
        </h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          Diagnostic test results are uploaded directly into your logged-in patient portal, or you can pick up physical copies from the ground floor reception desk.
        </p>
      </div>
    </div>
  </section>

</div>